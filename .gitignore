# Ignorar archivos y directorios de Drupal comunes



# Directorios generados

/web/sites/*/files/2*
/web/sites/*/files/cs*
/web/sites/*/files/j*
/web/sites/*/files/l*
/web/sites/*/files/p*
/web/sites/*/files/s*
/web/sites/*/files/t*
/web/sites/*/files/1*
/web/sites/*/files/.h*
/web/sites/*/files/cov*
/web/sites/*/files/zinco_pdfs/


/web/sites/*/private/
/web/sites/*/temp/
/vendor/
/web/modules/contrib/
/web/profiles/contrib/
/web/libraries/


# Archivos de configuración locales


/drush/drush.yml
/drush/sites/self.site.yml



# Archivos de caché y temporales
*.sql
*.sqlite
*.bak
*.swp
*.log
*.DS_Store
Thumbs.db
.sass-cache/
.idea/
.vscode/
npm-debug.log
yarn-error.log

# Archivos generados por Composer
composer.lock
/web/core/
# Archivos y directorios de entornos de desarrollo (opcional)
.ddev/
.lando/
.vagrant/
config/sync/
backups/

# Archivos de depuración y desarrollo
phpcs.xml
phpstan.neon
phpunit.xml
behat.yml



# Ignorar archivos específicos de drush que pueden ser generados
drush/drush.local.yml

# Ignorar archivos de pruebas
/tests/

# Ignorar el directorio de sincronización de configuración si se usa Drush config export/import
# Esto es crucial para la gestión de configuración en Drupal 8/9/10
/config/sync/

# Archivos de entornos específicos que no deben ser versionados
.env
.env.*

# Ignorar archivos de registro de Composer y NPM/Yarn
composer-asset-plugin.json
package-lock.json
yarn.lock

# Archivos de compilación de frontend (si aplica)
/web/themes/custom/*/node_modules/
/web/themes/custom/*/dist/
/web/themes/custom/*/build/

# Archivos de Drupal específicos para el sitio
/web/sites/default/settings.php