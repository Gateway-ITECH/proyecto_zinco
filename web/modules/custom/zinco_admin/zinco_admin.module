<?php

/**
 * @file
 * Primary module hooks for Zinco Admin module.
 */

/**
 * Implements hook_theme().
 */
function zinco_admin_theme() {
  return [
    'zinco_admin_dashboard' => [
      'variables' => [
        'title' => NULL,
        'tables' => [],
      ],
      'template' => 'zinco-admin-dashboard',
      'base hook' => 'page',
    ],
  ];
}


