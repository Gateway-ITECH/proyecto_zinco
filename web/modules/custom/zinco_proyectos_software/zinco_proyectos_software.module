<?php

declare(strict_types=1);

/**
 * @file
 * Provides a zinco proyectos software entity type.
 */

use Drupal\Core\Render\Element;
use Drupal\user\UserInterface;

/**
 * Implements hook_theme().
 */
function zinco_proyectos_software_theme(): array {
  return [
    'zinco_proyectos_software' => ['render element' => 'elements'],
  ];
}

/**
 * Prepares variables for zinco proyectos software templates.
 *
 * Default template: zinco-proyectos-software.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the zinco proyectos software information and any
 *     fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_zinco_proyectos_software(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Implements hook_user_cancel().
 */
function zinco_proyectos_software_user_cancel($edit, UserInterface $account, $method): void {
  switch ($method) {
    case 'user_cancel_block_unpublish':
      // Unpublish zinco proyectos softwares.
      $storage = \Drupal::entityTypeManager()->getStorage('zinco_proyectos_software');
      $zinco_proyectos_software_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->condition('status', 1)
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($zinco_proyectos_software_ids) as $zinco_proyectos_software) {
        $zinco_proyectos_software->set('status', FALSE)->save();
      }
      break;

    case 'user_cancel_reassign':
      // Anonymize zinco proyectos softwares.
      $storage = \Drupal::entityTypeManager()->getStorage('zinco_proyectos_software');
      $zinco_proyectos_software_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($zinco_proyectos_software_ids) as $zinco_proyectos_software) {
        $zinco_proyectos_software->setOwnerId(0)->save();
      }
      break;
  }
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for user entities.
 */
function zinco_proyectos_software_user_predelete(UserInterface $account): void {
  // Delete zinco proyectos softwares that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('zinco_proyectos_software');
  $zinco_proyectos_software_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($zinco_proyectos_software_ids)
  );
}
