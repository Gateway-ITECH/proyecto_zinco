{#
/**
 * @file
 * Template for the Convocatoria Detail page.
 */
#}
<section class="zinco-convocatoria-detail py-5 mt-5">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm overflow-hidden rounded-4 mb-4">
          <div class="card-body p-4 p-md-5">
            <div class="mb-4">
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                  <li class="breadcrumb-item"><a href="/oportunidades">Oportunidades</a></li>
                  <li class="breadcrumb-item active" aria-current="page">Convocatorias</li>
                </ol>
              </nav>
            </div>

            {% if convocatoria.days_remaining is defined and convocatoria.days_remaining < 0 %}
              <span class="badge bg-secondary mb-3 px-3 py-2 rounded-pill"><i class="fas fa-lock me-1"></i> Cerrada</span>
            {% elseif convocatoria.urgency_class == 'urgent' %}
              <span class="badge bg-danger mb-3 px-3 py-2 rounded-pill"><i class="fas fa-exclamation-circle me-1"></i> {{ convocatoria.urgency_label }}</span>
            {% elseif convocatoria.urgency_class == 'warning' %}
              <span class="badge bg-warning text-dark mb-3 px-3 py-2 rounded-pill"><i class="fas fa-clock me-1"></i> {{ convocatoria.urgency_label }}</span>
            {% elseif convocatoria.urgency_class == 'normal' and convocatoria.days_remaining > 0 %}
              <span class="badge bg-success mb-3 px-3 py-2 rounded-pill"><i class="fas fa-check-circle me-1"></i> {{ convocatoria.urgency_label }}</span>
            {% endif %}

            <h1 class="display-4 fw-bold mb-4 text-dark">{{ convocatoria.title }}</h1>

            <div class="convocatoria-content fs-5 text-secondary lh-lg mb-0">
              <h4 class="text-dark fw-bold mb-3 border-bottom pb-2">Descripción de la Convocatoria</h4>
              {{ convocatoria.content_full|raw }}
            </div>
          </div>
        </div>

        <div class="convocatoria-actions pt-2">
          <a href="/oportunidades" class="btn btn-outline-secondary btn-lg rounded-pill px-4 hover-shadow">
            <i class="fas fa-arrow-left me-2"></i> Volver a Oportunidades
          </a>
        </div>
      </div>

      <div class="col-lg-4 mt-4 mt-lg-0">
        <div class="convocatoria-sidebar p-4 rounded-4 bg-light border shadow-sm sticky-sidebar">
          <h4 class="fw-bold mb-4 border-bottom pb-2 border-secondary">Fechas Clave</h4>
          
          <div class="mb-4">
            <label class="text-uppercase small fw-bold text-muted d-block mb-2">Apertura</label>
            <div class="d-flex align-items-center">
              <i class="far fa-calendar-plus text-success me-3 fs-4"></i>
              <span class="fw-semibold text-dark fs-5">{{ convocatoria.opening_date ?: 'No definida' }}</span>
            </div>
          </div>

          <div class="mb-4">
            <label class="text-uppercase small fw-bold text-muted d-block mb-2">Cierre</label>
            <div class="d-flex align-items-center">
              <i class="far fa-calendar-times text-danger me-3 fs-4"></i>
              <span class="fw-semibold text-dark fs-5">{{ convocatoria.closing_date ?: 'No definida' }}</span>
            </div>
          </div>

          {% if convocatoria.category %}
            <div class="mb-4 pt-3 border-top border-secondary">
              <label class="text-uppercase small fw-bold text-muted d-block mb-2">Categoría / Tipo</label>
              <div class="d-flex align-items-center">
                <i class="fas fa-tags text-primary me-3 fs-5"></i>
                <span class="fw-semibold text-dark">{{ convocatoria.category }}</span>
              </div>
            </div>
          {% endif %}

          <div class="mt-5">
            <button class="btn btn-primary w-100 btn-lg rounded-pill shadow-sm hover-shadow" {% if convocatoria.days_remaining is defined and convocatoria.days_remaining < 0 %}disabled{% endif %}>
              Postularse a la Convocatoria <i class="fas fa-paper-plane ms-2"></i>
            </button>
            {% if convocatoria.days_remaining is defined and convocatoria.days_remaining < 0 %}
              <small class="d-block text-center text-muted mt-2">Esta convocatoria ha cerrado.</small>
            {% endif %}
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
.zinco-convocatoria-detail {
  background-color: #f8fafc;
  min-height: 80vh;
}

.sticky-sidebar {
  position: sticky;
  top: 100px;
}

.convocatoria-content p {
  margin-bottom: 1.5rem;
  color: #475569;
}

.breadcrumb-item a {
  color: #7fc54d;
  text-decoration: none;
  font-weight: 500;
  transition: color 0.3s ease;
}

.breadcrumb-item a:hover {
  color: #619a3b;
}

.text-primary {
  color: #7fc54d !important;
}
.btn-primary {
  background-color: #7fc54d;
  border-color: #7fc54d;
  color: white;
}
.btn-primary:hover {
  background-color: #619a3b;
  border-color: #619a3b;
}

.hover-shadow:hover {
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  transform: translateY(-1px);
}
</style>
