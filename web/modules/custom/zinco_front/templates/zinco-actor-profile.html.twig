                </button>
              </h2>
              <div id="collapseInnovationActivity" class="accordion-collapse collapse show" aria-labelledby="headingInnovationActivity" data-bs-parent="#accordionInnovationActivity">
                <div class="accordion-body">
                  <ul class="nav nav-tabs" id="innovationTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                      <button class="nav-link active" id="projects-idi-tab" data-bs-toggle="tab" data-bs-target="#projects-idi" type="button" role="tab" aria-controls="projects-idi" aria-selected="true">Proyectos I+D+i</button>
                    </li>
                    <li class="nav-item" role="presentation">
                      <button class="nav-link" id="incentives-received-tab" data-bs-toggle="tab" data-bs-target="#incentives-received" type="button" role="tab" aria-controls="incentives-received" aria-selected="false">Incentivos recibidos</button>
                    </li>
                  </ul>
                  <div class="tab-content pt-3" id="innovationTabContent">
                    <div class="tab-pane fade show active" id="projects-idi" role="tabpanel" aria-labelledby="projects-idi-tab">
                      {% for proyecto in actor.proyectos_idi %}
                        <div class="card mb-2">
                          <div class="card-body">
                            <p class="mb-0">{{ proyecto.label }}</p>
                            <p class="text-muted mb-0"><small>Tipo: {{ proyecto.tipo }} | Estado: {{ proyecto.estado }}</small></p>
                          </div>
                        </div>
                      {% endfor %}
                      
                    </div>
                    <div class="tab-pane fade" id="incentives-received" role="tabpanel" aria-labelledby="incentives-received-tab">
                      {% for incentivo in actor.incentivos_recibidos %}
                        <div class="card mb-2">
                          <div class="card-body">
                            <p class="mb-0">{{ incentivo }}</p>
                          </div>
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
 
          {% if actor.reconocimientos_actor is not empty %}
            <div class="card mb-3 shadow-sm border-0" style="border-radius: 15px; border-left: 5px solid #ffc107 !important; background-color: #f8fff9;">
              <div class="card-body">
                <h5 class="card-title mb-4 d-flex align-items-center text-dark">
                  <i class="fas fa-medal text-warning me-2"></i>{{ 'Reconocimientos Recibidos'|t }}
                </h5>
                <div class="row g-3">
                  {% for rec in actor.reconocimientos_actor %}
                    <div class="col-md-6">
                      <div class="p-3 bg-white rounded-3 shadow-sm h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                          <h6 class="fw-bold mb-0 text-dark small">{{ rec.label }}</h6>
                          <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill" style="font-size: 0.65rem;">{{ rec.fecha }}</span>
                        </div>
                        <p class="mb-0 text-muted small italic">"{{ rec.descripcion }}"</p>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}

          {# Placeholder for Innovation Challenges Accordion #}
          <div class="accordion mb-3" id="accordionInnovationChallenges">
            <div class="accordion-item">
              <h2 class="accordion-header" id="headingInnovationChallenges">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInnovationChallenges" aria-expanded="true" aria-controls="collapseInnovationChallenges">
                  Retos de innovación publicados
                </button>
              </h2>
              <div id="collapseInnovationChallenges" class="accordion-collapse collapse show" aria-labelledby="headingInnovationChallenges" data-bs-parent="#accordionInnovationChallenges">
