                        </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {# Placeholder for Innovation Challenges Accordion #}
          <div class="accordion mb-3" id="accordionInnovationChallenges">
            <div class="accordion-item">
              <h2 class="accordion-header" id="headingInnovationChallenges">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInnovationChallenges" aria-expanded="true" aria-controls="collapseInnovationChallenges">
                  Retos de innovación publicados
                </button>
              </h2>
              <div id="collapseInnovationChallenges" class="accordion-collapse collapse show" aria-labelledby="headingInnovationChallenges" data-bs-parent="#accordionInnovationChallenges">
                <div class="accordion-body">
                  {% for reto in actor.retos_innovacion %}
                        <div class="card mb-2">
                          <div class="card-body">
                            <p class="mb-0">{{ reto.label }}</p>
                            <p class="text-muted mb-0"><small>Tipo: {{ reto.tipo }} | Estado: {{ reto.estado }}</small></p>
                          </div>
                        </div>
                      {% endfor %}
                </div>
              </div>
            </div>
          </div>

          {% if actor.reconocimientos_actor is not empty %}
            <div class="card mb-3 shadow-sm border-0" style="border-radius: 15px; border-left: 5px solid #ffc107 !important; background-color: #f8fff9;">
              <div class="card-body">
                <h5 class="card-title mb-4 d-flex align-items-center text-dark">
                  <i class="fas fa-medal text-warning me-2"></i>{{ 'Reconocimientos Recibidos'|t }}
                </h5>
                <div class="row g-3">
                  {% for rec in actor.reconocimientos_actor %}
                    <div class="col-md-6">
                      <div class="p-3 bg-white rounded-3 shadow-sm h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                          <h6 class="fw-bold mb-0 text-dark small">{{ rec.label }}</h6>
                          <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill" style="font-size: 0.65rem;">{{ rec.fecha }}</span>
                        </div>
                        <p class="mb-0 text-muted small italic">"{{ rec.descripcion }}"</p>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}

        </div>
        <div class="col-md-4">
          <div class="card mb-3">
            <div class="card-body">
              <h5 class="card-title mb-4">Estudios realizados</h5>
              {% if actor.field_formacion_academica is not empty %}
                  {% for item in actor.field_formacion_academica %}
                      <div class="card mb-2">
                          <div class="card-body">
                              <p class="card-text">{{ item.titulo }} - {{ item.institucion }}</p>
                      <p class="text-muted mb-0"><small>Tipo: {{ item.tipo_formacion }} | Fecha inicio: {{ item.fecha_inicio }} | Fecha fin: {{ item.fecha_fin }}</small>
                          </div>
                      </div>
                  {% endfor %}
              {% else %}
                  <p class="card-text">No hay información de formación académica.</p>
              {% endif %}
            </div>
          </div>

          <div class="card mb-3">
            <div class="card-body">
              <h5 class="card-title mb-4">Trayectoria profesional</h5>
              {% if actor.field_trayectoria_profesional is not empty %}
                  {% for item in actor.field_trayectoria_profesional %}
                      <div class="card mb-2">
                          <div class="card-body">
                              <p class="card-text">{{ item.cargo }} - {{ item.empresa }}</p>
                      <p class="text-muted mb-0"><small>Fecha inicio: {{ item.fecha_inicio }} | Fecha fin: {{ item.fecha_fin }}</small>
                          </div>
                      </div>
                  {% endfor %}
              {% else %}
                  <p class="card-text">No hay información de trayectoria profesional.</p>
              {% endif %}
            </div>
          </div>

          {% if actor.datos_contacto is not empty %}
            <div class="card mb-3">
              <div class="card-body">
                <h5 class="card-title">Contacto</h5>
                
                {% if actor.datos_contacto.direccion_empresa is not empty %}
                  <p class="card-text mt-3"><span class="fas fa-map-marker-alt me-2"></span><strong>Dirección</strong></p>
                  <p class="card-text">{{ actor.datos_contacto.direccion_empresa }}</p>
                {% endif %}
                {% if actor.datos_contacto.telefono is not empty %}
                  <p class="card-text mt-3"><span class="fas fa-phone me-2"></span><strong>Teléfono</strong></p>
                  <p class="card-text">{{ actor.datos_contacto.telefono }}</p>
                {% endif %}
                {% if actor.datos_contacto.email is not empty %}
                  <p class="card-text mt-3"><span class="fas fa-envelope me-2"></span><strong>Email</strong></p>
                  <p class="card-text">{{ actor.datos_contacto.email }}</p>
                {% endif %}
                {% if actor.datos_contacto.sitio_web is not empty %}
                  <p class="card-text mt-3"><span class="fas fa-globe me-2"></span><strong>Sitio Web</strong></p>
                  <p class="card-text"><a href="{{ actor.datos_contacto.sitio_web }}" target="_blank">{{ actor.datos_contacto.sitio_web }}</a></p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    {% elseif actor.bundle_id == 'entidad_gobierno' %}
      <div class="card mb-3">
        <div class="row g-0">
          <div class="col-md-4 d-flex align-items-center justify-content-center">
            <img src="{{ actor.imagen_perfil ? actor.imagen_perfil : 'https://placehold.co/150' }}" class="img-fluid rounded-start p-3" alt="Government Entity Photo">
          </div>
          <div class="col-md-8">
            <div class="card-body">
              <h5 class="card-title">{{ actor.label }}</h5>
              <p class="card-text">{{ actor.field_nivel_gobierno }}</p>
              <p class="card-text"><small class="text-muted"><span class="fas fa-envelope me-1"></span>{{ actor.datos_contacto.email }} <span class="fas fa-phone me-1 ms-3"></span>{{ actor.datos_contacto.telefono }} <span class="fas fa-globe me-1 ms-3"></span><a href="{{ actor.datos_contacto.sitio_web }}" target="_blank">{{ actor.datos_contacto.sitio_web }}</a></small></p>
            </div>
          </div>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title">Información Básica</h5>
          <div class="row">
            <div class="col-md-6">
              <p class="card-text"><strong>Misión</strong></p>
              <p class="card-text">{{ actor.field_mision | raw }}</p>
            </div>
            <div class="col-md-6">
              <p class="card-text"><strong>Representante Legal</strong></p>
              <p class="card-text">{{ actor.field_representante_legal }}</p>
              <p class="card-text">{{ actor.field_cargo_representante_legal }}</p>
            </div>
          </div>
          <div class="row mt-3">
            <div class="col-md-6">
              <p class="card-text"><strong>Sede Principal</strong></p>
              <p class="card-text">{{ actor.field_sede_principal }}</p>
            </div>
          </div>
          <div class="row mt-3">
            <div class="col-md-12">
              <p class="card-text"><strong>Función en el Ecosistema CTI</strong></p>
              <p class="card-text">{{ actor.field_funcion_ecosistema_cti | raw }}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="accordion mb-3" id="accordionPolicies">
        <div class="accordion-item">
          <h2 class="accordion-header" id="headingPolicies">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePolicies" aria-expanded="true" aria-controls="collapsePolicies">
              Políticas y Marcos Regulatorios
            </button>
          </h2>
          <div id="collapsePolicies" class="accordion-collapse collapse show" aria-labelledby="headingPolicies" data-bs-parent="#accordionPolicies">
            <div class="accordion-body">
              <p class="mb-3"><strong>Políticas y Estrategias</strong></p>
              {% for item in actor.field_politicas_y_estrategias %}
                  <div class="card mb-2">
                    <div class="card-body">
                      <p class="mb-0">{{ item }}</p>
                    </div>
                  </div>
              {% endfor %}

              <p class="mb-3 mt-3"><strong>Marcos Regulatorios</strong></p>
              {% for item in actor.field_marcos_regulatorios %}
                  <div class="card mb-2">
                    <div class="card-body">
                      <p class="mb-0">{{ item }}</p>
                    </div>
                  </div>
              {% endfor %}

              <p class="mb-3 mt-3"><strong>Normativa o Políticas Internas Relevantes</strong></p>
              {% for item in actor.field_normativas %}
                  <div class="card mb-2">
                    <div class="card-body">
                      <p class="mb-0">{{ item }}</p>
                    </div>
                  </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      <div class="accordion mb-3" id="accordionPrograms">
        <div class="accordion-item">
          <h2 class="accordion-header" id="headingPrograms">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePrograms" aria-expanded="true" aria-controls="collapsePrograms">
              Programas, Convocatorias y Financiamiento
            </button>
          </h2>
          <div id="collapsePrograms" class="accordion-collapse collapse show" aria-labelledby="headingPrograms" data-bs-parent="#accordionPrograms">
            <div class="accordion-body">
              <p class="mb-3 mt-3"><strong>Programas Principales</strong></p>
               {% for item in actor.programas_principales %}
                  <div class="card mb-2">
                    <div class="card-body">
                      <p class="mb-0">{{ item }}</p>
                    </div>
                  </div>
              {% endfor %}

              <p class="mb-3 mt-3"><strong>Convocatorias Abiertas</strong></p>
              {% for item in actor.convocatorias_abiertas %}
                  <div class="card mb-2">
                    <div class="card-body">
                      <p class="mb-0">{{ item }}</p>
                    </div>
                  </div>
              {% endfor %}

              <p class="mb-3 mt-3"><strong>Mecanismos de Financiamiento</strong></p>
              {% for item in actor.field_mecanismos_financiamiento %}
                  <div class="card mb-2">
                    <div class="card-body">
                      <p class="mb-0">{{ item }}</p>
                    </div>
                  </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    {% elseif actor.bundle_id == 'instancias_de_orientacion_politi' %}
      <div class="card mb-3">
        <div class="row g-0">
          <div class="col-md-4 d-flex align-items-center justify-content-center">
            <img src="{{ actor.imagen_perfil ? actor.imagen_perfil : 'https://placehold.co/150' }}" class="img-fluid rounded-start p-3" alt="Government Entity Photo">
          </div>
          <div class="col-md-8">
            <div class="card-body">
              <h5 class="card-title">{{ actor.label }}</h5>
              <p class="card-text">{{ actor.field_nivel_gobierno }}</p>
              <p class="card-text"><small class="text-muted"><span class="fas fa-envelope me-1"></span>{{ actor.datos_contacto.email }} <span class="fas fa-phone me-1 ms-3"></span>{{ actor.datos_contacto.telefono }} <span class="fas fa-globe me-1 ms-3"></span><a href="{{ actor.datos_contacto.sitio_web }}" target="_blank">{{ actor.datos_contacto.sitio_web }}</a></small></p>
            </div>
          </div>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title">Información Básica</h5>
          <div class="row">
            <div class="col-md-6">
              <p class="card-text"><strong>Descripción</strong></p>
              <p class="card-text">{{ actor.description | raw }}</p>
            </div>
            <div class="col-md-6">
              <p class="card-text"><strong>Entidad líder</strong></p>
              <p class="card-text">{{ actor.field_entidad_lider }}</p>
            </div>
          </div>        
        </div>
      </div>

      <div class="accordion mb-3" id="accordionMembers">
        <div class="accordion-item">
          <h2 class="accordion-header" id="headingMembers">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#accordionMembers" aria-expanded="true" aria-controls="collapseMembers">
              Miembros
            </button>
          </h2>
          <div id="collapseMembers" class="accordion-collapse collapse show" aria-labelledby="headingMembers" data-bs-parent="#accordionMembers">
            <div class="accordion-body">
              {% for item in actor.field_miembros_iep %}
                  <div class="card mb-2">
                    <div class="card-body">
                      <a href="{{ item.url  }}">{{ item.label }}</a>
                    </div>
                  </div>
              {% endfor %}         
            </div>
          </div>
        </div>
      </div>

    {% else %}
      <div class="actor-profile-header">
        <h1 class="actor-profile-title">{{ actor.label }}</h1>
        <div class="actor-profile-type">
          <span class="badge bg-secondary">{{ actor.field_tipo_actor }}</span>
        </div>
      </div>

      <div class="actor-profile-body">
        {% if actor.description %}
          <div class="actor-profile-section">
            <h3>Descripción</h3>
            <p>{{ actor.description }}</p>
          </div>
        {% endif %}

        {% if actor.field_municipio %}
          <div class="actor-profile-section">
            <h3>Municipio</h3>
            <p>{{ actor.field_municipio }}</p>
          </div>
        {% endif %}

        {% if actor.field_fomento %}
          <div class="actor-profile-section">
            <h3>Fomento</h3>
            <p>{{ actor.field_fomento }}</p>
          </div>
        {% endif %}

        {% if actor.field_website %}
          <div class="actor-profile-section">
            <h3>Sitio Web</h3>
            <p><a href="{{ actor.field_website }}" target="_blank">{{ actor.field_website }}</a></p>
          </div>
        {% endif %}
      </div>

      <div class="actor-profile-footer">
        <a href="/actores/list" class="btn btn-primary">Volver a la lista de actores</a>
      </div>
    {% endif %}
  </div>
</div>
