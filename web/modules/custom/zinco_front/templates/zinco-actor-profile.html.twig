{#
/**
 * @file
 * Default theme implementation for a single actor profile.
 *
 * Available variables:
 * - actor: A renderable array of actor data.
 */
#}
<div class="container mt-7 mb-5">
  <div class="actor-profile-wrapper">
    <div class="position-relative">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/actores/list">Actores</a></li>
          <li class="breadcrumb-item active" aria-current="page">{{ actor.label }}</li>
        </ol>
      </nav>

      {% if user.hasRole('actor_registrado') %}
        <div class="actor-settings-dropdown dropdown position-absolute top-0 end-0">
          <button class="btn btn-light btn-sm shadow-sm rounded-circle" type="button" id="actorSettingsMenu" data-bs-toggle="dropdown" aria-expanded="false" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-cog fa-lg text-secondary"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="actorSettingsMenu">
            <li><h6 class="dropdown-header">Gestión de perfil</h6></li>
            <li><a class="dropdown-item py-2" href="/profile/edit"><i class="fas fa-user-edit me-2 text-primary"></i>Editar Perfil</a></li>
            <li><a class="dropdown-item py-2" href="/retos/add"><i class="fas fa-plus-circle me-2 text-success"></i>Publicar Reto</a></li>
            <li><a class="dropdown-item py-2" href="/reconocimientos/add"><i class="fas fa-certificate me-2 text-warning"></i>Solicitar Reconocimiento</a></li>
          </ul>
        </div>
      {% endif %}
    </div>

    {% if actor.bundle_id == 'empresa_explotadora_de_conocimie' or actor.bundle_id == 'empresa_generadora_de_conocimien' %}
      <div class="card mb-3">
        <div class="row g-0">
          <div class="col-md-3 d-flex align-items-center justify-content-center">
            <img src="{{ actor.imagen_perfil ? actor.imagen_perfil : 'https://placehold.co/100x100?text=Empresa' }}" class="img-fluid rounded-start p-3" alt="Company Logo">
          </div>
          <div class="col-md-9">
            <div class="card-body">
              <p class="card-text text-muted mb-0">{{ actor.field_tipo_actor }}</p>
              <h4 class="card-title">{{ actor.label }}</h4>
              <p class="card-text">
                <small class="text-muted">
                 <span class="fas fa-globe me-1 ms-3"></span>{{ actor.field_municipio }}
                </small>
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-8">
          <div class="card mb-3">
            <div class="card-body">
              <h5 class="card-title">Información general</h5>
               <div class="row">
                <div class="col-md-6">
                  <p class="card-text text-muted mb-0">Razón Social</p>
                  <p class="card-text">{{ actor.label }}</p>
                </div>
                <div class="col-md-6">
                  <p class="card-text text-muted mb-0">NIT</p>
                  <p class="card-text">{{ actor.nit_empresa }}</p>
                </div>
                <div class="col-md-12">
                  <p class="card-text text-muted mb-0">Descripción de la Empresa</p>
                  <p class="card-text">{{ actor.description | raw }}</p>
                </div>
              </div>
              
            </div>
          </div>

          {# Placeholder for Innovation Activity Accordion #}
          <div class="accordion mb-3" id="accordionInnovationActivity">
            <div class="accordion-item">
              <h2 class="accordion-header" id="headingInnovationActivity">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInnovationActivity" aria-expanded="true" aria-controls="collapseInnovationActivity">
                  Actividad de innovación
                </button>
              </h2>
              <div id="collapseInnovationActivity" class="accordion-collapse collapse show" aria-labelledby="headingInnovationActivity" data-bs-parent="#accordionInnovationActivity">
                <div class="accordion-body">
                  <ul class="nav nav-tabs" id="innovationTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                      <button class="nav-link active" id="projects-idi-tab" data-bs-toggle="tab" data-bs-target="#projects-idi" type="button" role="tab" aria-controls="projects-idi" aria-selected="true">Proyectos I+D+i</button>
                    </li>
                    <li class="nav-item" role="presentation">
                      <button class="nav-link" id="incentives-received-tab" data-bs-toggle="tab" data-bs-target="#incentives-received" type="button" role="tab" aria-controls="incentives-received" aria-selected="false">Incentivos recibidos</button>
                    </li>
                  </ul>
                  <div class="tab-content pt-3" id="innovationTabContent">
                    <div class="tab-pane fade show active" id="projects-idi" role="tabpanel" aria-labelledby="projects-idi-tab">
                      {% for proyecto in actor.proyectos_idi %}
                        <div class="card mb-2">
                          <div class="card-body">
                            <p class="mb-0">{{ proyecto.label }}</p>
                            <p class="text-muted mb-0"><small>Tipo: {{ proyecto.tipo }} | Estado: {{ proyecto.estado }}</small></p>
                          </div>
                        </div>
                      {% endfor %}
                      
                    </div>
                    <div class="tab-pane fade" id="incentives-received" role="tabpanel" aria-labelledby="incentives-received-tab">
                      {% for incentivo in actor.incentivos_recibidos %}
                        <div class="card mb-2">
                          <div class="card-body">
                            <p class="mb-0">{{ incentivo }}</p>
                          </div>
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {# Placeholder for Innovation Challenges Accordion #}
          <div class="accordion mb-3" id="accordionInnovationChallenges">
            <div class="accordion-item">
              <h2 class="accordion-header" id="headingInnovationChallenges">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInnovationChallenges" aria-expanded="true" aria-controls="collapseInnovationChallenges">
                  Retos de innovación publicados
                </button>
              </h2>
              <div id="collapseInnovationChallenges" class="accordion-collapse collapse show" aria-labelledby="headingInnovationChallenges" data-bs-parent="#accordionInnovationChallenges">
                <div class="accordion-body">
                  {% for reto in actor.retos_innovacion %}
                        <div class="card mb-2">
                          <div class="card-body">
                            <p class="mb-0">{{ reto.label }}</p>
                            <p class="text-muted mb-0"><small>Tipo: {{ reto.tipo }} | Estado: {{ reto.estado }}</small></p>
                          </div>
                        </div>
                      {% endfor %}
                </div>
              </div>
            </div>
          </div>

          {% if actor.reconocimientos_actor is not empty %}
            <div class="card mb-3 shadow-sm border-0" style="border-radius: 15px; border-left: 5px solid #ffc107 !important; background-color: #f8fff9;">
              <div class="card-body">
                <h5 class="card-title mb-4 d-flex align-items-center text-dark">
                  <i class="fas fa-medal text-warning me-2"></i>{{ 'Reconocimientos Recibidos'|t }}
                </h5>
                <div class="row g-3">
                  {% for rec in actor.reconocimientos_actor %}
                    <div class="col-md-6">
                      <div class="p-3 bg-white rounded-3 shadow-sm h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                          <h6 class="fw-bold mb-0 text-dark small">{{ rec.label }}</h6>
                          <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill" style="font-size: 0.65rem;">{{ rec.fecha }}</span>
                        </div>
                        <p class="mb-0 text-muted small italic">"{{ rec.descripcion }}"</p>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}

        </div>

        <div class="col-md-4">
          {% if actor.acciones_rapidas %}
          <div class="card mb-3">
            <div class="card-body">
              <h5 class="card-title mb-4">Acciones rápidas</h5>
              <p class="card-text"><a href="/retos/list">Mis retos de innovación</a></p>
              <p class="card-text"><a href="/proyectos/list">Mis proyectos I+D+i</a></p>
              <p class="card-text"><a href="/profile/edit">Editar mi perfil</a></p>
            </div>
          </div>
          {% endif %}

          <div class="card mb-3">
            <div class="card-body">
              <h5 class="card-title mb-4">Líneas de negocio e innovación</h5>
              {% if actor.lineas_negocio is not empty %}
                  {% for linea in actor.lineas_negocio %}
                      <p class="card-text">{{ linea }}</p>
                  {% endfor %}
              {% else %}
                  <p class="card-text">No hay líneas de negocio disponibles.</p>
              {% endif %}
            </div>
          </div>

          {% if actor.datos_contacto is not empty %}
            <div class="card mb-3">
              <div class="card-body">
                <h5 class="card-title">Contacto</h5>
                
                {% if actor.datos_contacto.direccion_empresa is not empty %}
                  <p class="card-text mt-3"><span class="fas fa-map-marker-alt me-2"></span><strong>Dirección</strong></p>
                  <p class="card-text">{{ actor.datos_contacto.direccion_empresa }}</p>
                {% endif %}
                {% if actor.datos_contacto.telefono is not empty %}
                  <p class="card-text mt-3"><span class="fas fa-phone me-2"></span><strong>Teléfono</strong></p>
                  <p class="card-text">{{ actor.datos_contacto.telefono }}</p>
                {% endif %}
                {% if actor.datos_contacto.email is not empty %}
                  <p class="card-text mt-3"><span class="fas fa-envelope me-2"></span><strong>Email</strong></p>
                  <p class="card-text">{{ actor.datos_contacto.email }}</p>
                {% endif %}
                {% if actor.datos_contacto.sitio_web is not empty %}
                  <p class="card-text mt-3"><span class="fas fa-globe me-2"></span><strong>Sitio Web</strong></p>
                  <p class="card-text"><a href="{{ actor.datos_contacto.sitio_web }}" target="_blank">{{ actor.datos_contacto.sitio_web }}</a></p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>

    {% elseif actor.bundle_id == 'institucion_de_educacion_superio' %}
      <div class="card mb-3">
        <div class="row g-0">
          <div class="col-md-3 d-flex align-items-center justify-content-center">
            <img src="{{ actor.imagen_perfil ? actor.imagen_perfil : 'https://placehold.co/100x100?text=Empresa' }}" class="img-fluid rounded-start p-3" alt="Company Logo">
          </div>
          <div class="col-md-9">
            <div class="card-body">
