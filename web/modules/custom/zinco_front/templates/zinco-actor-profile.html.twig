                </small>
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-8">
          <div class="card mb-3">
            <div class="card-body">
              <h5 class="card-title">Información general</h5>
               <div class="row">
                <div class="col-md-6 mt-1">
                  <p class="card-text text-muted mb-0">Nombre completo</p>
                  <p class="card-text">{{ actor.label }}</p>
                </div>
                <div class="col-md-6 mt-1">
                  <p class="card-text text-muted mb-0">Afiliación actual</p>
                  <p class="card-text">{{ actor.field_afiliacion_actual }}</p>
                </div>
                <div class="col-md-6 mt-1">
                  <p class="card-text text-muted mb-0">Nacionalidad</p>
                  <p class="card-text">{{ actor.field_nacionalidad }}</p>
                </div>
                <div class="col-md-6 mt-1">
                  <p class="card-text text-muted mb-0">Fecha de nacimiento</p>
                  <p class="card-text">{{ actor.field_fecha_de_nacimiento }}</p>
                </div>
              </div>
              
            </div>
          </div>

          {# Placeholder for Innovation Activity Accordion #}
          <div class="accordion mb-3" id="accordionInnovationActivity">
            <div class="accordion-item">
              <h2 class="accordion-header" id="headingInnovationActivity">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInnovationActivity" aria-expanded="true" aria-controls="collapseInnovationActivity">
                  Actividad de innovación
                </button>
              </h2>
              <div id="collapseInnovationActivity" class="accordion-collapse collapse show" aria-labelledby="headingInnovationActivity" data-bs-parent="#accordionInnovationActivity">
                <div class="accordion-body">
                  <ul class="nav nav-tabs" id="innovationTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                      <button class="nav-link active" id="projects-idi-tab" data-bs-toggle="tab" data-bs-target="#projects-idi" type="button" role="tab" aria-controls="projects-idi" aria-selected="true">Proyectos I+D+i</button>
                    </li>
                    <li class="nav-item" role="presentation">
                      <button class="nav-link" id="grupos-investigacion-tab" data-bs-toggle="tab" data-bs-target="#grupos-investigacion" type="button" role="tab" aria-controls="grupos-investigacion" aria-selected="false">Grupos de investigación</button>
                    </li>
                  </ul>
                  <div class="tab-content pt-3" id="innovationTabContent">
                    <div class="tab-pane fade show active" id="projects-idi" role="tabpanel" aria-labelledby="projects-idi-tab">
                      {% for proyecto in actor.proyectos_idi %}
                        <div class="card mb-2">
                          <div class="card-body">
                            <p class="mb-0">{{ proyecto.label }}</p>
                            <p class="text-muted mb-0"><small>Tipo: {{ proyecto.tipo }} | Estado: {{ proyecto.estado }}</small></p>
                          </div>
                        </div>
                      {% endfor %}
                      
                    </div>
                    <div class="tab-pane fade" id="grupos-investigacion" role="tabpanel" aria-labelledby="grupos-investigacion-tab">
