{#
/**
 * @file
 * Template for email granting access to register a new actor.
 *
 * Available variables:
 * - variables: Array of data (user_name, user_email, actor_name, tipo_actor_solicitado, registro_url, detail_url).
 * - site_name: The name of the site.
 */
#}
<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #333; max-width: 620px; margin: 0 auto; border: 1px solid #e1e4e8; border-radius: 12px; overflow: hidden; background-color: #ffffff;">
  <!-- Header -->
  <div style="background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%); padding: 25px 20px; text-align: center; color: white;">
    <h1 style="margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.5px;">{{ 'Acceso Habilitado para Nuevo Actor'|t }}</h1>
    <p style="margin: 6px 0 0; opacity: 0.9; font-size: 14px;">{{ site_name }}</p>
  </div>
  
  <!-- Body -->
  <div style="padding: 30px 25px;">
    <p style="font-size: 16px; margin-top: 0;">
      {{ '¡Hola, @user_name!'|t({'@user_name': variables.user_name|default('Usuario')}) }}
    </p>

    <p style="color: #495057; font-size: 15px;">
      {{ 'Nos complace informarte que tu solicitud de reconocimiento para el perfil de actor <strong>@actor</strong> ha sido aprobada.'|t({'@actor': variables.actor_name})|raw }}
    </p>

    <div style="background-color: #f8fff9; border-left: 4px solid #28a745; padding: 16px 20px; border-radius: 6px; margin: 20px 0;">
      <p style="margin: 0; font-size: 15px; color: #1e7e34;">
        {{ 'Se ha autorizado y habilitado el acceso para que puedas crear y asociar un nuevo perfil como:'|t }}<br>
        <strong style="font-size: 17px; display: inline-block; margin-top: 6px;">{{ variables.tipo_actor_solicitado }}</strong>
      </p>
    </div>

    <!-- Registration Button -->
    <div style="text-align: center; margin: 30px 0;">
      <a href="{{ variables.registro_url }}" style="background-color: #28a745; color: #ffffff; padding: 14px 30px; text-decoration: none; border-radius: 8px; font-weight: 700; font-size: 15px; display: inline-block; box-shadow: 0 4px 6px rgba(40,167,69,0.2);">
        {{ 'Registrar mi nuevo perfil de actor'|t }}
      </a>
    </div>

    <!-- Summary Box -->
    <div style="background-color: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 18px 20px; margin: 25px 0; font-size: 14px;">
      <div style="margin-bottom: 8px;"><strong>{{ 'Usuario:'|t }}</strong> {{ variables.user_name }} ({{ variables.user_email }})</div>
      <div style="margin-bottom: 8px;"><strong>{{ 'Actor actual asociado:'|t }}</strong> {{ variables.actor_name }}</div>
      <div><strong>{{ 'Nuevo tipo autorizado:'|t }}</strong> <span style="background-color: #e2f0d9; color: #276a3c; padding: 2px 8px; border-radius: 4px; font-weight: 600;">{{ variables.tipo_actor_solicitado }}</span></div>
    </div>

    <!-- Instructions -->
    <div style="background-color: #ffffff; border: 1px solid #dee2e6; border-radius: 8px; padding: 16px 20px; font-size: 13px; color: #6c757d;">
      <strong style="color: #495057; display: block; margin-bottom: 6px;">{{ '¿Cómo funciona?'|t }}</strong>
      <ol style="margin: 0; padding-left: 18px;">
        <li style="margin-bottom: 4px;">{{ 'Haz clic en el botón superior o copia el enlace de registro.'|t }}</li>
        <li style="margin-bottom: 4px;">{{ 'Inicia sesión con tu cuenta actual si aún no estás conectado.'|t }}</li>
        <li>{{ 'Al completar y guardar el formulario, este nuevo perfil quedará automáticamente vinculado a tu cuenta. Podrás alternar entre tus perfiles desde "Editar mi perfil".'|t }}</li>
      </ol>
    </div>

    <p style="font-size: 12px; color: #868e96; margin-top: 25px; word-break: break-all;">
      {{ 'Enlace directo de registro:'|t }}<br>
      <a href="{{ variables.registro_url }}" style="color: #28a745;">{{ variables.registro_url }}</a>
    </p>
  </div>
  
  <!-- Footer -->
  <div style="background-color: #f8f9fa; border-top: 1px solid #e9ecef; padding: 16px 20px; text-align: center; font-size: 12px; color: #868e96;">
    <p style="margin: 0;">&copy; {{ "now"|date("Y") }} {{ site_name }}. {{ 'Todos los derechos reservados.'|t }}</p>
  </div>
</div>
