{#
/**
 * @file
 * Template for the Upcoming Events block.
 *
 * Available variables:
 * - events: Array of event items with:
 *   - id: Node ID
 *   - title: Event title
 *   - url: URL to the event node
 *   - date_full: Full formatted date
 *   - date_day: Day number
 *   - date_month: Month abbreviation
 *   - date_year: Year
 *   - time_label: Human-readable time label (Hoy, Mañana, etc.)
 *   - days_until: Number of days until event
 *   - location: Event location
 *   - description: Event description excerpt
 */
#}

{% if events %}
<section class="zinco-upcoming-events-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="upcoming-events-header mb-4">
          <h2 class="section-title">Próximos eventos</h2>
          <p class="section-subtitle">Descubre los eventos más cercanos en nuestra plataforma</p>
        </div>
      </div>
    </div>
    
    <div class="row g-4">
      {% for event in events %}
        <div class="col-12 col-md-6 col-lg-4">
          <article class="event-card">
            <a href="{{ event.url }}" class="event-card-link">
              <div class="event-card-header">
                <div class="event-date-badge">
                  <span class="event-date-day">{{ event.date_day }}</span>
                  <span class="event-date-month">{{ event.date_month }}</span>
                </div>
                
                {% if event.time_label %}
                  <div class="event-time-label">
                    <i class="far fa-clock"></i>
                    <span>{{ event.time_label }}</span>
                  </div>
                {% endif %}
              </div>
              
              <div class="event-card-body">
                <h3 class="event-card-title">{{ event.title }}</h3>
                
                {% if event.location %}
                  <div class="event-card-location">
                    <i class="fas fa-map-marker-alt"></i>
                    <span>{{ event.location }}</span>
                  </div>
                {% endif %}
                
                {% if event.description %}
                  <p class="event-card-description">{{ event.description }}</p>
                {% endif %}
                
                <span class="event-card-read-more">
                  Ver detalles <i class="fas fa-arrow-right"></i>
                </span>
              </div>
            </a>
          </article>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% else %}
  <div class="no-events-message">
    <i class="far fa-calendar-times"></i>
    <p>No hay eventos próximos programados en este momento.</p>
  </div>
{% endif %}
