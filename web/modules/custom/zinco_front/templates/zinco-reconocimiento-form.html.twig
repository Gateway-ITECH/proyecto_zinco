{#
/**
 * @file
 * Template for the recognition request form.
 *
 * Available variables:
 * - form: The renderable array of the recognition form.
 * - title: The title of the page.
 */
#}
<div class="reconocimiento-form-container container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-lg overflow-hidden" style="border-radius: 15px;">
        <div class="card-header bg-gradient-reconocimiento py-4 px-4 text-white">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <h1 class="h3 mb-1 fw-bold">{{ title }}</h1>
              <p class="mb-0 opacity-75 small">
                {{ 'Completa el formulario para solicitar un nuevo reconocimiento.'|t }}
              </p>
            </div>
            <div class="d-none d-md-block">
              <i class="fas fa-certificate fa-3x opacity-25"></i>
            </div>
          </div>
        </div>
        
        <div class="card-body p-4 p-md-5 bg-white">
          <div class="reconocimiento-form-wrapper">
            {{ form }}
          </div>
        </div>

        <div class="card-footer bg-light py-3 px-4 text-center">
          <a href="/actores/mi-perfil" class="btn btn-link text-secondary text-decoration-none small">
            <i class="fas fa-arrow-left me-1"></i>{{ 'Volver a mi perfil'|t }}
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .bg-gradient-reconocimiento {
    background: linear-gradient(135deg, #17a2b8 0%, #117a8b 100%);
  }
  
  .reconocimiento-form-container .card {
    border: 1px solid rgba(0,0,0,0.05);
  }
  
  .reconocimiento-form-wrapper form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .reconocimiento-form-wrapper label {
    font-weight: 600;
    color: #495057;
    margin-bottom: 0.5rem;
    display: block;
  }
  
  .reconocimiento-form-wrapper input[type="text"],
  .reconocimiento-form-wrapper select,
  .reconocimiento-form-wrapper textarea {
    border-radius: 8px;
    border: 1px solid #ced4da;
    padding: 0.75rem 1rem;
    width: 100%;
  }
  
  .reconocimiento-form-wrapper .form-actions {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #eee;
    display: flex;
    justify-content: flex-end;
  }
  
  .reconocimiento-form-wrapper .form-actions input[type="submit"] {
    background-color: #17a2b8;
    color: white;
    padding: 0.75rem 2.5rem;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    transition: all 0.2s;
  }
  
  .reconocimiento-form-wrapper .form-actions input[type="submit"]:hover {
    background-color: #138496;
    transform: translateY(-1px);
  }
</style>
