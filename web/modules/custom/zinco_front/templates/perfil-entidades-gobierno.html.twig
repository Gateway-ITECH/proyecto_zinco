<div class="card mb-3">
  <div class="row g-0">
    <div class="col-md-4 d-flex align-items-center justify-content-center">
      <img src="{{ actor.imagen_perfil ? actor.imagen_perfil : 'https://placehold.co/150' }}" class="img-fluid rounded-circle p-3" alt="Government Entity Photo">
    </div>
    <div class="col-md-8">
      <div class="card-body">
        <h5 class="card-title">{{ actor.label }}</h5>
        <p class="card-text">{{ actor.field_nivel_gobierno }}</p>
        <p class="card-text"><small class="text-muted"><span class="fas fa-envelope me-1"></span>{{ actor.field_email }} <span class="fas fa-phone me-1 ms-3"></span>{{ actor.field_telefono }} <span class="fas fa-globe me-1 ms-3"></span><a href="{{ actor.field_website }}" target="_blank">{{ actor.field_website }}</a></small></p>
      </div>
    </div>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <h5 class="card-title">Información básica</h5>
    <div class="row">
      <div class="col-md-6">
        <p class="card-text"><strong>Misión</strong></p>
        <p class="card-text">{{ actor.field_mision | raw }}</p>
      </div>
      <div class="col-md-6">
        <p class="card-text"><strong>Representante Legal</strong></p>
        <p class="card-text">{{ actor.field_representante_legal }}</p>
        <p class="card-text">{{ actor.field_cargo_representante }}</p>
      </div>
    </div>
    <div class="row mt-3">
      <div class="col-md-6">
        <p class="card-text"><strong>Sede Principal</strong></p>
        <p class="card-text">{{ actor.field_sede_principal }}</p>
      </div>
    </div>
    <div class="row mt-3">
      <div class="col-md-12">
        <p class="card-text"><strong>Función en el Ecosistema CTI</strong></p>
        <p class="card-text">{{ actor.field_funcion_ecosistema | raw }}</p>
      </div>
    </div>
  </div>
</div>

<div class="accordion mb-3" id="accordionPolicies">
  <div class="accordion-item">
    <h2 class="accordion-header" id="headingPolicies">
      <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePolicies" aria-expanded="true" aria-controls="collapsePolicies">
        Políticas y marcos regulatorios
      </button>
    </h2>
    <div id="collapsePolicies" class="accordion-collapse collapse show" aria-labelledby="headingPolicies" data-bs-parent="#accordionPolicies">
      <div class="accordion-body">
        <p class="mb-0"><strong>Políticas y Estrategias</strong></p>
        <p class="mb-0">{{ actor.field_politicas_estrategias | raw }}</p>
        <p class="text-primary mb-3">Ver más</p>

        <p class="mb-0"><strong>Marcos Regulatorios</strong></p>
        <p class="mb-0">{{ actor.field_marcos_regulatorios | raw }}</p>
        <p class="text-primary mb-3">Ver más</p>

        <p class="mb-0"><strong>Normativa o Políticas Internas Relevantes</strong></p>
        <p class="mb-0">{{ actor.field_normativa_interna | raw }}</p>
        <p class="text-primary mb-0">Ver más</p>
      </div>
    </div>
  </div>
</div>

<div class="accordion mb-3" id="accordionPrograms">
  <div class="accordion-item">
    <h2 class="accordion-header" id="headingPrograms">
      <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePrograms" aria-expanded="true" aria-controls="collapsePrograms">
        Programas, convocatorias y financiamiento
      </button>
    </h2>
    <div id="collapsePrograms" class="accordion-collapse collapse show" aria-labelledby="headingPrograms" data-bs-parent="#accordionPrograms">
      <div class="accordion-body">
        <p class="mb-0"><strong>Programas Principales</strong></p>
        <ul>
          {% for programa in actor.field_programas_principales %}
            <li>{{ programa }}</li>
          {% endfor %}
        </ul>

        <p class="mb-0"><strong>Convocatorias Abiertas</strong></p>
        <p class="mb-0">{{ actor.field_convocatorias_abiertas | raw }}</p>
        <p class="text-primary mb-3">Ver convocatorias cerradas</p>

        <p class="mb-0"><strong>Mecanismos de Financiamiento</strong></p>
        <p class="mb-0">{{ actor.field_mecanismos_financiamiento | raw }}</p>
      </div>
    </div>
  </div>
</div>