                <p class="card-text text-muted mb-0">Razón Social</p>
                <p class="card-text">Agro-Innovación S.A.S.</p>
              </div>
              <div class="col-md-6">
                <p class="card-text text-muted mb-0">NIT</p>
                <p class="card-text">900.123.456-7</p>
              </div>
