{#
/**
 * @file
 * Default theme implementation for a list of Zinco Actor Categories.
 *
 * Available variables:
 * - terms: An array of actor category data, each with:
 *   - id: The machine name of the term.
 *   - label: The human-readable label of the term.
 *   - description: The description of the term.
 */
#}
{% if terms %}
  <p>{{ 'Selecciona una categoría de actor para continuar'|t }}</p>
  <div class="row">
    {% for term in terms %}
      <div class="col-sm-6 col-md-4 col-lg-3 mb-4">
        <div class="card h-100" style="min-height: 150px">
          <div class="card-body text-center">
            {% if term.logotipo %}
              <div class="logo-container">
                <img src="{{ term.logotipo }}" alt="{{ term.label }}" class="term-logo">
              </div>
            {% else %}
              <div class="logo-container">
                <i class="fas fa-image fa-3x text-muted"></i>
              </div>
            {% endif %}
            <h5 class="card-title mb-3" style="color: #333; min-height: 100px">{{ term.label }}</h5>
            <p class="card-text">{{ term.description }}</p>
            {# Assuming a route to display actors by category or a category detail page #}
            <a href="/actores/bundles/{{ term.id }}" class="btn btn-primary">{{ 'Seleccionar'|t }}</a>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% else %}
  <p>{{ 'No se encontraron categorías de actores.'|t }}</p>
{% endif %}