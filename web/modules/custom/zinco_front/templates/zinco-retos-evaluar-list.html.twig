{#
/**
 * @file
 * Default theme implementation for a list of retos to evaluate.
 *
 * Available variables:
 * - soluciones: An array of solutions to evaluate, each with the following keys:
 *   - id: The ID of the solution.
 *   - label: The label/title of the solution.
 *   - description: The description of the solution.
 *   - authors: A comma-separated string of authors of the solution.
 *   - reto_asociado: The name of the associated reto.
 *   - evaluate_link: The link to evaluate the solution.
 */
#}
<div class="zinco-retos-evaluar-list container mt-5">
  <div class="bg-white p-4 shadow-sm rounded mb-4">
    <h2 class="mb-0 text-primary fw-bold"><i class="fas fa-tasks me-2"></i>{{ 'Soluciones a Evaluar'|t }}</h2>
    <p class="text-muted">{{ 'Listado de propuestas de solución asignadas para su revisión técnica.'|t }}</p>
  </div>

  {% if soluciones %}
    <div class="row">
      {% for solucion in soluciones %}
        <div class="col-12 mb-4">
          <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
              <div class="row align-items-center">
                <div class="col-lg-8">
                  <div class="d-flex align-items-center mb-2">
                    <h5 class="card-title mb-0 fw-bold text-dark">{{ solucion.label }}</h5>
                  </div>
                  <div class="card-text text-muted mb-3">
                    {{ solucion.description|striptags|length > 250 ? solucion.description|striptags|slice(0, 250) ~ '...' : solucion.description|striptags }}
                  </div>
                  <div class="d-flex flex-wrap gap-4 mt-3">
                    <div class="info-item">
                      <small class="text-secondary"><i class="fas fa-users me-1 text-primary"></i> <strong>{{ 'Autores'|t }}:</strong> {{ solucion.authors }}</small>
                    </div>
                    <div class="info-item">
                      <small class="text-secondary"><i class="fas fa-lightbulb me-1 text-primary"></i> <strong>{{ 'Reto Asociado'|t }}:</strong> <a href="/retos/{{ solucion.reto_asociado_id }}" target="_blank" class="text-decoration-none hover-link">{{ solucion.reto_asociado }}</a></small>
                    </div>
                  </div>
                </div>
                <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                  <a href="{{ solucion.evaluate_link }}" class="btn btn-primary px-5 py-2 fw-bold shadow-sm rounded-pill">
                    {{ 'Evaluar Solución'|t }} <i class="fas fa-chevron-right ms-2"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="alert alert-info shadow-sm">
      <i class="fas fa-info-circle me-2"></i> {{ 'No hay soluciones disponibles para evaluar en este momento.'|t }}
    </div>
  {% endif %}
</div>