{#
/**
 * @file zinco-actores-list.html.twig
 * Default theme implementation to display a list of actors.
 *
 * Available variables:
 * - actors: An array of actor entities.
 * - title: The title of the page.
 *
 * @ingroup themeable
 */
#}
<div class="zinco-actores-list">
  <div class="row align-items-center mb-3">
    <div class="col">
      <h2>Actores</h2>
    </div>
    <div class="col-auto">
      <button class="btn btn-primary" id="toggle_actores_filter">{{ 'Filtros'|t }}</button>
    </div>
  </div>
  <div class="row">
    <div class="col-md-3 hidden" id="actors_filters">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-funnel-fill"></i> {{ 'Filtros'|t }}</h5>
          <div class="mb-3">
            <label for="search-filter" class="form-label">{{ 'Buscar'|t }}</label>
            <input type="text" class="form-control" id="search-filter" placeholder="{{ 'Nombre, especialidad...'|t }}">
          </div>
          <div class="mb-3">
            <label class="form-label">{{ 'Tipo de Actor'|t }}</label>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="" id="investigador">
              <label class="form-check-label" for="investigador">
                <i class="bi bi-person"></i> {{ 'Investigadores'|t }}
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="" id="empresa_explotadora_de_conocimie">
              <label class="form-check-label" for="empresa_explotadora_de_conocimie">
                <i class="bi bi-building"></i> {{ 'Empresas Explotadoras'|t }}
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="" id="empresa_generadora_de_conocimien">
              <label class="form-check-label" for="empresa_generadora_de_conocimien">
                <i class="bi bi-briefcase"></i> {{ 'Empresas Generadoras'|t }}
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="" id="entidad_gobierno">
              <label class="form-check-label" for="entidad_gobierno">
                <i class="bi bi-bank"></i> {{ 'Entidades Gubernamentales'|t }}
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="" id="instancias_de_orientacion_politi">
              <label class="form-check-label" for="instancias_de_orientacion_politi">
                <i class="bi bi-people"></i> {{ 'Instancias Políticas'|t }}
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="" id="institucion_de_educacion_superio">
              <label class="form-check-label" for="institucion_de_educacion_superio">
                <i class="bi bi-mortarboard"></i> {{ 'Instituciones Educación Superior'|t }}
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="" id="parque_tecnologico">
              <label class="form-check-label" for="parque_tecnologico">
                <i class="bi bi-globe"></i> {{ 'Parques Tecnológicos'|t }}
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="" id="otri">
              <label class="form-check-label" for="otri">
                <i class="bi bi-grid"></i> {{ 'Otri'|t }}
              </label>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
              <button type="button" class="btn btn-primary" id="apply_filters">{{ 'Aplicar'|t }}</button>
              <button type="button" class="btn btn-secondary" id="clear_filters">{{ 'Limpiar'|t }}</button>
            </div>
          </div>
        </div>
        
      </div>
    </div>
    <div class="col">
      {% if actors %}
        <div class="row row-cols-1 row-cols-md-3 g-4">
          {% for actor in actors %}
            <div class="col">
              <div class="card h-100">
                <div class="card-body">
                  <div class="d-flex align-items-center mb-2">
                    {# Placeholder for icon, you might use an actual icon font or SVG here #}
                    <span class="me-2"><i class="bi bi-building"></i></span>
                    <h5 class="card-title mb-0">{{ actor.label }}</h5>
                  </div>
                  <span class="badge {{ actor.bundle_color }} mb-2">{{ actor.field_tipo_actor }}</span>
                  {% if actor.description %}
                    <p class="card-text">{{ actor.description }}</p>
                  {% endif %}
                  {% if actor.field_municipio %}
                    <p class="card-text"><i class="bi bi-geo-alt-fill"></i> {{ actor.field_municipio }}</p>
                  {% endif %}
                  {% if actor.field_fomento %}
                    <p class="card-text">{{ actor.field_fomento }}</p>
                  {% endif %}
                  {% if actor.field_website %}
                    <p class="card-text"><i class="bi bi-globe"></i> <a href="{{ actor.field_website }}" target="_blank">Sitio web</a></p>
                  {% endif %}
                  {% if actor.profile_link %}
                    <a href="{{ actor.profile_link }}" class="btn btn-primary w-100">{{ 'Ver Perfil'|t }}</a>
                  {% endif %}
                </div>
                

              </div>
            </div>
          {% endfor %}
        </div>
        {% if pager %}
          <div class="row mt-4">
            <div class="col-12 pagination-links">
              {{ pager }}
            </div>
          </div>
        {% endif %}
      {% else %}
        <p>{{ 'No se encontraron actores.'|t }}</p>
      {% endif %}
    </div>
  </div>
</div>