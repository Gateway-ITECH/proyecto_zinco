{#
/**
 * @file
 * Template for viewing recognition request detail.
 *
 * Available variables:
 * - reconocimiento: Array of recognition data.
 */
#}
<div class="reconocimiento-detail-container container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="card border-0 shadow-lg overflow-hidden" style="border-radius: 20px;">
        <!-- Header -->
        <div class="card-header bg-gradient-detail py-4 px-4 text-white position-relative">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                  <li class="breadcrumb-item"><a href="/actores/{{ reconocimiento.actor_id }}/reconocimientos" class="text-white opacity-75 text-decoration-none small">{{ 'Listado'|t }}</a></li>
                  <li class="breadcrumb-item active text-white small" aria-current="page">{{ 'Detalle'|t }}</li>
                </ol>
              </nav>
              <h1 class="h2 mb-0 fw-bold">{{ reconocimiento.label }}</h1>
              <div class="mt-2 d-flex flex-wrap align-items-center gap-2">
                <span class="badge bg-white text-primary rounded-pill px-3 py-2 small fw-bold">
                  <i class="fas fa-calendar-alt me-1"></i>{{ reconocimiento.created }}
                </span>
                <span class="badge {{ reconocimiento.procesada ? 'bg-success' : 'bg-warning text-dark' }} rounded-pill px-3 py-2 small fw-bold">
                  {{ reconocimiento.status }}
                </span>
                {% if reconocimiento.tipo_actor_solicitado and reconocimiento.tipo_actor_solicitado != 'No especificado' %}
                  <span class="badge bg-info text-white rounded-pill px-3 py-2 small fw-bold">
                    <i class="fas fa-tag me-1"></i>{{ 'Aspira a:'|t }} {{ reconocimiento.tipo_actor_solicitado }}
                  </span>
                {% endif %}
              </div>
            </div>
            <div class="d-none d-md-block">
              <i class="fas fa-medal fa-4x opacity-25"></i>
            </div>
          </div>
        </div>

        <div class="card-body p-4 p-md-5 bg-white">
          <div class="row g-5">
            <!-- Left Column: Solicitud -->
            <div class="col-md-7">
              <div class="section-card mb-5">
                <h3 class="h5 border-bottom pb-3 mb-4 text-primary fw-bold">
                  <i class="fas fa-paper-plane me-2"></i>{{ 'Información de la Solicitud'|t }}
                </h3>
                <div class="solicitud-content p-4 bg-light rounded-4 shadow-sm">
                  {{ reconocimiento.solicitud }}
                </div>
                
                {% if reconocimiento.soporte %}
                  <div class="mt-4 p-3 border border-dashed rounded-3 d-flex align-items-center">
                    <i class="fas fa-file-download fa-2x text-info me-3"></i>
                    <div>
                      <div class="fw-bold small">{{ 'Soporte Adjunto'|t }}</div>
                      {{ reconocimiento.soporte }}
                    </div>
                  </div>
                {% endif %}
              </div>

              <div class="section-card">
                <h3 class="h5 border-bottom pb-3 mb-4 text-success fw-bold">
                  <i class="fas fa-reply me-2"></i>{{ 'Respuesta de la Solicitud'|t }}
                </h3>
                {% if reconocimiento.respuesta %}
                  <div class="respuesta-content p-4 border border-success border-opacity-25 rounded-4 bg-success bg-opacity-10 shadow-sm italic">
                    {{ reconocimiento.respuesta }}
                  </div>
                {% else %}
                  <div class="alert alert-warning border-0 rounded-4 shadow-sm d-flex align-items-center">
                    <i class="fas fa-hourglass-half me-3 fa-lg"></i>
                    <div>{{ 'Esta solicitud aún no tiene una respuesta registrada.'|t }}</div>
                  </div>
                {% endif %}
              </div>
            </div>

            <!-- Right Column: Meta Info & Actions -->
            <div class="col-md-5">
              <div class="card bg-light border-0 rounded-4 p-4 sticky-top" style="top: 2rem;">
                <h4 class="h6 fw-bold text-muted mb-4 letter-spacing-1 text-uppercase">{{ 'Detalles del proceso'|t }}</h4>
                
                <!-- Usuario Originador -->
                <div class="mb-3 pb-3 border-bottom">
                  <label class="text-muted small d-block mb-1 fw-semibold">{{ 'Usuario Originador'|t }}</label>
                  <div class="fw-bold text-dark">
                    <i class="fas fa-user-circle me-2 text-primary"></i>{{ reconocimiento.owner_name }}
                  </div>
                  {% if reconocimiento.owner_email %}
                    <small class="text-muted d-block ms-4">{{ reconocimiento.owner_email }}</small>
                  {% endif %}
                </div>

                <!-- Tipo de Actor Solicitado -->
                <div class="mb-3 pb-3 border-bottom">
                  <label class="text-muted small d-block mb-1 fw-semibold">{{ 'Tipo de Actor al que Aspira'|t }}</label>
                  <div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-bold">
                      <i class="fas fa-award me-1"></i>{{ reconocimiento.tipo_actor_solicitado }}
                    </span>
                  </div>
                </div>

                <!-- Actor Solicitante -->
                <div class="mb-3 pb-3 border-bottom">
                  <label class="text-muted small d-block mb-1 fw-semibold">{{ 'Actor Solicitante'|t }}</label>
                  <div class="fw-bold text-dark">
                    <i class="fas fa-building me-2 text-info"></i>{{ reconocimiento.actor|default('N/A') }}
                  </div>
                  {% if reconocimiento.actor_bundle %}
                    <small class="text-muted d-block ms-4">Tipo actual: {{ reconocimiento.actor_bundle }}</small>
                  {% endif %}
                </div>

                <!-- Validado por -->
                <div class="mb-3">
                  <label class="text-muted small d-block mb-1 fw-semibold">{{ 'Validado por'|t }}</label>
                  <div class="fw-bold text-dark">
                    <i class="fas fa-user-shield me-2 text-secondary"></i>{{ reconocimiento.validador }}
                  </div>
                </div>

                <!-- Acciones del Administrador -->
                {% if reconocimiento.is_admin %}
                  <div class="admin-actions-card mt-3 pt-3 border-top">
                    <h5 class="small fw-bold text-primary mb-3 text-uppercase letter-spacing-1">
                      <i class="fas fa-tools me-1"></i>{{ 'Acciones del Administrador'|t }}
                    </h5>
                    <div class="d-grid gap-2">
                      <a href="{{ reconocimiento.enviar_acceso_url }}" class="btn btn-success fw-bold py-2 shadow-xs"
                         onclick="return confirm('¿Confirmas el envío de un correo de acceso al usuario {{ reconocimiento.owner_email }} para que pueda agregar el nuevo actor de tipo {{ reconocimiento.tipo_actor_solicitado }}?');">
                        <i class="fas fa-paper-plane me-2"></i>{{ 'Enviar acceso por email para nuevo actor'|t }}
                      </a>

                      {% if not reconocimiento.procesada %}
                        <a href="/reconocimientos/{{ reconocimiento.id }}/responder" class="btn btn-primary fw-bold py-2 shadow-xs">
                          <i class="fas fa-reply me-2"></i>{{ 'Registrar Respuesta Oficial'|t }}
                        </a>
                      {% endif %}

                      <a href="/admin/content/zinco-reconocimientos" class="btn btn-outline-secondary btn-sm py-1 mt-1">
                        <i class="fas fa-list me-1"></i>{{ 'Ir a Gestión Administrativa'|t }}
                      </a>
                    </div>
                  </div>
                {% else %}
                  <div class="d-grid gap-2 mt-4 pt-3 border-top">
                    {% if not reconocimiento.procesada %}
                      <a href="/reconocimientos/{{ reconocimiento.id }}/responder" class="btn btn-primary rounded-pill shadow-sm py-2 fw-bold">
                        <i class="fas fa-edit me-2"></i>{{ 'Registrar Respuesta'|t }}
                      </a>
                    {% endif %}
                  </div>
                {% endif %}

                <div class="mt-3 text-center">
                  <a href="/actores/{{ reconocimiento.actor_id }}/reconocimientos" class="btn btn-link text-secondary text-decoration-none small">
                    <i class="fas fa-arrow-left me-1"></i>{{ 'Volver al listado'|t }}
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .bg-gradient-detail {
    background: linear-gradient(135deg, #17a2b8 0%, #117a8b 100%);
  }
  
  .letter-spacing-1 { letter-spacing: 0.8px; }
  
  .solicitud-content, .respuesta-content {
    line-height: 1.8;
    color: #444;
  }
  
  .border-dashed { border-style: dashed !important; }
  
  .section-card h3 {
    font-size: 1.1rem;
    letter-spacing: 0.5px;
  }

  .bg-success-subtle {
    background-color: #d1e7dd;
  }

  .border-success-subtle {
    border-color: #a3cfbb !important;
  }
</style>
