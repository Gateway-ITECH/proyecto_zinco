{#
/**
 * @file
 * Template for recognition response notification to users.
 *
 * Available variables:
 * - variables: Array of data (user_name, label, respuesta, detail_url).
 * - site_name: The name of the site.
 */
#}
<div style="font-family: sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; border: 1px solid #eee; border-radius: 10px; overflow: hidden;">
  <div style="background-color: #007bff; padding: 20px; text-align: center; color: white;">
    <h1 style="margin: 0; font-size: 24px;">{{ 'Respuesta a tu Solicitud de Reconocimiento'|t }}</h1>
    <p style="margin: 5px 0 0; opacity: 0.8;">{{ site_name }}</p>
  </div>
  
  <div style="padding: 30px;">
    <p>{{ 'Hola'|t }} {{ variables.user_name }},</p>
    <p>{{ 'Tu solicitud de reconocimiento "%label" ha sido procesada.'|t({ '%label': variables.label }) }}</p>
    
    <div style="background-color: #e9ecef; padding: 25px; border-radius: 12px; margin: 25px 0; border-left: 5px solid #28a745;">
      <h3 style="margin: 0 0 15px; color: #28a745;">{{ 'Respuesta:'|t }}</h3>
      <div style="font-style: italic; color: #495057;">
        {{ variables.respuesta|raw }}
      </div>
    </div>
    
    <p>{{ 'Puedes ver todos los detalles y descargar soportes en el siguiente enlace:'|t }}</p>
    
    <div style="text-align: center; margin-top: 30px;">
      <a href="{{ variables.detail_url }}" style="background-color: #28a745; color: white; padding: 12px 25px; text-decoration: none; border-radius: 5px; font-weight: bold; display: inline-block;">
        {{ 'Ver Solicitud Completa'|t }}
      </a>
    </div>
  </div>
  
  <div style="background-color: #f1f1f1; padding: 15px; text-align: center; font-size: 12px; color: #777;">
    <p style="margin: 0;">&copy; {{ "now"|date("Y") }} {{ site_name }}. {{ 'Todos los derechos reservados.'|t }}</p>
  </div>
</div>
