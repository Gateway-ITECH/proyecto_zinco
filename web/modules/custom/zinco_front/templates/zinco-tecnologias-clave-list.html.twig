{#
/**
 * @file
 * Template for listing technologies key taxonomy terms.
 *
 * Available variables:
 * - terms: An array of terms, each containing:
 *   - id: The term ID.
 *   - name: The term name.
 *   - description: The term description (render array).
 */
#}
<div class="tecnologias-clave-list container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white py-3">
          <h2 class="h4 mb-0"><i class="fas fa-microchip me-2"></i>{{ 'Áreas de Enfoque'|t }}</h2>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col" style="width: 30%;">{{ 'Nombre'|t }}</th>
                  <th scope="col">{{ 'Descripción'|t }}</th>
                </tr>
              </thead>
              <tbody>
                {% for term in terms %}
                  <tr>
                    <td class="fw-bold text-primary">{{ term.name }}</td>
                    <td>
                      <div class="text-muted small">
                        {{ term.description }}
                      </div>
                    </td>
                  </tr>
                {% else %}
                  <tr>
                    <td colspan="2" class="text-center py-4 text-muted">
                      {{ 'No se encontraron áreas de enfoque.'|t }}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
      
      <div class="mt-4 text-center">
        <button onclick="window.close()" class="btn btn-secondary">
          <i class="fas fa-times me-2"></i>{{ 'Cerrar ventana'|t }}
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .tecnologias-clave-list .table td {
    vertical-align: middle;
    padding: 1.25rem 1rem;
  }
  .tecnologias-clave-list .card {
    border-radius: 12px;
    overflow: hidden;
  }
  .tecnologias-clave-list .card-header {
    background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
  }
</style>
