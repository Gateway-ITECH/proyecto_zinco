{#
/**
 * @file
 * Template for listing technologies key taxonomy terms.
 *
 * Available variables:
 * - terms: An array of terms, each containing:
 *   - id: The term ID.
 *   - name: The term name.
 *   - description: The term description (render array).
 */
#}
<div class="tecnologias-clave-list container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="card border shadow-sm">
        <div class="card-header py-3">
          <h2 class="h4 mb-0 text-white"><i class="fas fa-microchip me-2"></i>{{ 'Áreas de Enfoque'|t }}</h2>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-bordered mb-0">
              <thead>
                <tr>
                  <th scope="col" style="width: 30%;">{{ 'Nombre'|t }}</th>
                  <th scope="col">{{ 'Descripción'|t }}</th>
                </tr>
              </thead>
              <tbody>
                {% for term in terms %}
                  <tr>
                    <td class="fw-bold">{{ term.name }}</td>
                    <td class="text-dark">
                      {{ term.description }}
                    </td>
                  </tr>
                {% else %}
                  <tr>
                    <td colspan="2" class="text-center py-4 text-muted">
                      {{ 'No se encontraron áreas de enfoque.'|t }}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
      
      <div class="mt-4 text-center">
        <button onclick="window.close()" class="btn btn-dark px-4">
          <i class="fas fa-times me-2"></i>{{ 'Cerrar ventana'|t }}
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .tecnologias-clave-list {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }
  .tecnologias-clave-list .card {
    border-radius: 8px;
    background-color: #fff;
  }
  .tecnologias-clave-list .card-header {
    background-color: #28a745; /* Verde Zinco */
    border-bottom: none;
    border-radius: 8px 8px 0 0;
  }
  .tecnologias-clave-list .table {
    background-color: #ffffff;
    color: #000000;
  }
  .tecnologias-clave-list .table thead th {
    background-color: #28a745;
    color: #ffffff;
    border-color: #28a745;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
    padding: 12px 15px;
  }
  .tecnologias-clave-list .table td {
    vertical-align: middle;
    padding: 15px;
    border-color: #dee2e6;
    color: #000000;
  }
  .tecnologias-clave-list .table tr:hover {
    background-color: #f8f9fa;
  }
  .tecnologias-clave-list .btn-dark {
    background-color: #212529;
    border: none;
  }
</style>
