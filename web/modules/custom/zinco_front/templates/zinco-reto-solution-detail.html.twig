{#
/**
 * @file zinco-reto-solution-detail.html.twig
 * Default theme implementation to display a single solution.
 *
 * Available variables:
 * - solution: A renderable array of the solution data.
 * - reto: A renderable array of the associated reto data.
 */
#}
<div class="reto-detail-page"> {# Reusing reto-detail-page class for similar styling #}
  <div class="container">
    <div class="row">
      <div class="col-md-8">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/retos/list">Retos</a></li>
            {% if reto.id %}
              <li class="breadcrumb-item"><a href="/retos/{{ reto.id }}">{{ reto.label }}</a></li>
            {% endif %}
            <li class="breadcrumb-item active" aria-current="page">{{ solution.label }}</li>
          </ol>
        </nav>
        <h1 class="reto-title-detail">{{ solution.label }}</h1>
        <p class="text-muted">Publicado el: {{ solution.created|date('d/m/Y') }}</p>

        {% if solution.authors %}
          <div class="card mb-4">
            <div class="card-body">
              <h5 class="card-title">Autores de la Solución</h5>
              <ul class="list-group list-group-flush">
                {% for author in solution.authors %}
                  <li class="list-group-item"><i class="fas fa-user"></i> <a href="{{ author.profile_link }}">{{ author.name }}</a></li>
                {% endfor %}
              </ul>
            </div>
          </div>
        {% endif %}

        <div class="reto-section">
          <h3>Descripción de la Solución</h3>
          <p>{{ solution.description | raw }}</p>
        </div>

        {% if reto.id %}
          <div class="reto-section mt-4">
            <h2>Reto Asociado: <a href="/retos/{{ reto.id }}">{{ reto.label }}</a></h2>
            <p class="reto-subtitle">{{ reto.descripcion_corta }}</p>

            <div class="card mb-4">
              <div class="card-body">
                <h5 class="card-title">Detalles del reto</h5>
                <ul class="list-group list-group-flush">
                  <li class="list-group-item"><i class="fas fa-user"></i> <strong>Organizadores</strong><br>{{ reto.organizador_reto }}</li>
                  <li class="list-group-item"><i class="fas fa-trophy"></i> <strong>Premios</strong><br> {{ reto.recompensas_reto | raw }}</li>
                  <li class="list-group-item"><i class="fas fa-calendar-alt"></i> <strong>Fecha límite</strong><br> {{ reto.fecha_fin }}</li>
                </ul>
              </div>
            </div>

            {% if reto.estado_reto_innovacion %}
              <div class="card mb-4">
                <div class="card-body">
                  <h5 class="card-title">Fase Actual</h5>
                  <span class="badge bg-primary"><i class="{{ reto.estado_icono }}"></i> {{ reto.estado_reto_innovacion }}</span>
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="col-md-4">
        {% if is_evaluator %}
          <div class="card mb-4">
            <div class="card-body">
              <h5 class="card-title">Calificar propuesta</h5>
              <div class="mt-3">
                <a href="/retos/calificar/{{ solution.id }}" class="btn btn-primary">{{ 'Evaluar Solución'|t }}</a>
              </div>
            </div>
          </div>
        {% endif %}

        {% if solution.files %}
          <div class="card mb-4">
            <div class="card-body">
              <h5 class="card-title">Archivos Adjuntos</h5>
              <ul class="list-group list-group-flush">
                {% for file in solution.files %}
                  <li class="list-group-item"><a href="{{ file.url }}" target="_blank"><i class="fas fa-file-alt"></i> {{ file.filename }}</a></li>
                {% endfor %}
              </ul>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    {# --- Evaluation Results Section --- #}
    {% if evaluaciones is not empty %}
      <div class="row mt-4">
        <div class="col-12">
          <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
              <h5 class="mb-0 fw-bold text-secondary">
                <i class="fas fa-clipboard-check me-2 text-success"></i>{{ 'Resultados de Evaluación'|t }}
                <span class="badge bg-secondary ms-2">{{ evaluaciones|length }}</span>
              </h5>
            </div>
            <div class="card-body p-4">
              {% for eval in evaluaciones %}
                <div class="bg-light rounded p-3 mb-3">

                  {# Score table #}
                  {% if eval.puntuaciones is not empty %}
                    <div class="table-responsive mb-3">
                      <table class="table table-sm table-bordered mb-0">
                        <thead class="table-light">
                          <tr>
                            <th><i class="fas fa-list-check me-1"></i>{{ 'Criterio'|t }}</th>
                            <th><i class="fas fa-star me-1"></i>{{ 'Calificación'|t }}</th>
                          </tr>
                        </thead>
                        <tbody>
                          {% for puntuacion in eval.puntuaciones %}
                            <tr>
                              <td class="fw-semibold">{{ puntuacion.criterio }}</td>
                              <td><span class="badge bg-primary">{{ puntuacion.calificacion }}</span></td>
                            </tr>
                          {% endfor %}
                        </tbody>
                      </table>
                    </div>
                  {% endif %}

                  {# Comments #}
                  {% if eval.comentarios %}
                    <div class="mb-2">
                      <small class="text-secondary fw-bold"><i class="fas fa-comment me-1"></i>{{ 'Comentarios'|t }}:</small>
                      <p class="mb-0 text-muted small mt-1">{{ eval.comentarios }}</p>
                    </div>
                  {% endif %}

                  {# Footer: evaluator + date #}
                  <div class="d-flex justify-content-between align-items-center mt-2">
                    {% if eval.evaluador %}
                      <small class="text-secondary"><i class="fas fa-user-check me-1 text-success"></i><strong>{{ 'Evaluador'|t }}:</strong> {{ eval.evaluador }}</small>
                    {% else %}
                      <span></span>
                    {% endif %}
                    {% if eval.fecha %}
                      <small class="text-secondary"><i class="fas fa-calendar-alt me-1"></i>{{ eval.fecha|date('d/m/Y H:i') }}</small>
                    {% endif %}
                  </div>

                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    {% endif %}

  </div>
</div>