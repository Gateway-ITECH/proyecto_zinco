<div class="container my-5">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h2 text-primary mb-1">Resumen de Evaluaciones</h1>
          <p class="text-muted"><i class="fas fa-bullseye me-2"></i><strong>Reto:</strong> {{ reto.label }}</p>
        </div>
        <a href="/retos/{{ reto.id }}" class="btn btn-outline-secondary btn-sm">
          <i class="fas fa-arrow-left me-2"></i>Volver al Reto
        </a>
      </div>

      {% if results %}
        <div class="card shadow-sm border-0 overflow-hidden">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="bg-light">
                <tr>
                  <th class="ps-4 py-3">Nombre de la Propuesta</th>
                  <th class="text-center py-3">Promedio de Calificación (Ponderado)</th>
                  <th class="text-end pe-4 py-3">Acciones</th>
                </tr>
              </thead>
              <tbody>
                {% for result in results %}
                  <tr>
                    <td class="ps-4 py-3">
                      <div class="fw-bold text-dark">{{ result.label }}</div>
                      <small class="text-muted">ID: {{ result.id }}</small>
                    </td>
                    <td class="text-center py-3">
                      <div class="d-inline-block px-3 py-2 rounded-pill {% if result.average >= 4 %}bg-success text-white{% elseif result.average >= 3 %}bg-warning text-dark{% else %}bg-danger text-white{% endif %} fw-bold" style="min-width: 60px;">
                        {{ result.average }}
                      </div>
                    </td>
                    <td class="text-end pe-4 py-3">
                      <a href="/retos/evaluar/{{ result.id }}" class="btn btn-sm btn-primary">
                        <i class="fas fa-eye me-1"></i> Ver Detalle
                      </a>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      {% else %}
        <div class="alert alert-info shadow-sm p-4 text-center">
          <i class="fas fa-info-circle fa-2x mb-3 text-info"></i>
          <p class="mb-0">Aún no hay postulaciones evaluadas para este reto.</p>
        </div>
      {% endif %}
    </div>
  </div>
</div>
