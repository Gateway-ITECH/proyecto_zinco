{#
/**
 * @file
 * Default theme implementation for the Zinco Landing Page adapted for ACI Medellín style.
 */
#}
<div class="zinco-landing-page">

  {# Hero Carousel #}
  <div id="heroCarousel" class="carousel slide hero-carousel" data-bs-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active" style="background: url('https://acimedellin.org/wp-content/uploads/2023/11/Banner-Home-Web-ACI-Nov.jpg') center/cover no-repeat;">
        <div class="carousel-overlay">
          <div class="container text-center text-lg-start text-white">
            <div class="row">
              <div class="col-lg-8 hero-content">
                <h1>{{ fields.field_hero_section_title ? fields.field_hero_section_title : 'Agencia de Cooperación e Inversión de Medellín' }}</h1>
                <p class="mt-4 mb-5">{{ fields.field_hero_section_description ? fields.field_hero_section_description : 'Conectamos a Medellín con el mundo para generar desarrollo, oportunidades y transformación social.' }}</p>
                <div class="hero-btns">
                  <a href="{{ fields.field_hero_section_link ? fields.field_hero_section_link : '#' }}" class="btn btn-aci-primary me-3 mb-3">{{ fields.field_hero_section_button_label ? fields.field_hero_section_button_label : 'CONOCE MÁS' }}</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      {# Second Slide (Static or placeholder) #}
      <div class="carousel-item" style="background: url('https://acimedellin.org/wp-content/uploads/2023/11/Banner-Home-Web-ACI-Nov.jpg') center/cover no-repeat; filter: hue-rotate(45deg);">
        <div class="carousel-overlay">
          <div class="container text-center text-lg-start text-white">
            <div class="row">
              <div class="col-lg-8 hero-content">
                <h1>Medellín: Distrito de Ciencia, Tecnología e Innovación</h1>
                <p class="mt-4 mb-5">Somos el epicentro de la innovación en América Latina, atrayendo talento y capital global.</p>
                <div class="hero-btns">
                  <a href="#" class="btn btn-aci-primary me-3 mb-3">CONOCE MÁS</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>

  {# Quiénes Somos Section #}
  <section id="quienes-somos" class="py-5">
    <div class="container">
      <div class="section-header">
        <h2 class="text-uppercase">¿Quiénes somos?</h2>
      </div>
      <div class="quienes-somos-content">
        <p>ZINCO (Zona de Innovación de Córdoba) es la plataforma oficial de articulación del Ecosistema de Ciencia, Tecnología e Innovación (CTeI) soportado en transformación digital e industrias 4.0 del departamento de Córdoba.</p>
        <p>Nuestro propósito es fortalecer la interacción efectiva entre los actores del ecosistema, promoviendo procesos de generación, transferencia y apropiación del conocimiento.</p>
      </div>
    </div>
  </section>

  {# Numbers Section (Integrated with ACI style) #}
  <section class="zinco-numbers-section py-5 bg-light">
    <div class="container">
      <h2 class="text-center mb-5 fw-bold text-uppercase" style="color: var(--aci-blue-dark);">{{ fields.field_data_clave_titulo ? fields.field_data_clave_titulo : 'Datos Clave' }}</h2>
      <div class="row g-4 justify-content-center">
        <div class="col-md-4">
          <div class="card h-100 service-card p-4 text-center">
            <div class="icon-container"><i class="fas fa-users"></i></div>
            <p class="fw-bold text-uppercase small" style="color: var(--aci-blue-primary);">{{ fields.field_actores_registrados_label ? fields.field_actores_registrados_label : 'Actores Registrados' }}</p>
            <span class="display-4 fw-bold" style="color: var(--aci-blue-dark);">{{ fields.field_actores_registrados ? fields.field_actores_registrados : '0' }}</span>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 service-card p-4 text-center">
            <div class="icon-container"><i class="fas fa-project-diagram"></i></div>
            <p class="fw-bold text-uppercase small" style="color: var(--aci-blue-primary);">{{ fields.field_proyectos_activos_label ? fields.field_proyectos_activos_label : 'Proyectos Activos' }}</p>
            <span class="display-4 fw-bold" style="color: var(--aci-blue-dark);">{{ fields.field_proyectos_activos ? fields.field_proyectos_activos : '0' }}</span>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 service-card p-4 text-center">
            <div class="icon-container"><i class="fas fa-handshake"></i></div>
            <p class="fw-bold text-uppercase small" style="color: var(--aci-blue-primary);">{{ fields.field_colaboraciones_title ? fields.field_colaboraciones_title : 'Colaboraciones' }}</p>
            <span class="display-4 fw-bold" style="color: var(--aci-blue-dark);">{{ fields.field_colaboraciones_facilitadas ? fields.field_colaboraciones_facilitadas : '0' }}+</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {# Te Guiamos / Beneficios Section #}
  <section class="py-5" id="te-guiamos">
    <div class="container">
      <div class="section-header">
        <h2 class="text-uppercase">{{ fields.field_beneficios_title ? fields.field_beneficios_title : 'Beneficios' }}</h2>
      </div>
      <div class="row g-4 mt-4">
        <div class="col-md-4">
          <div class="card h-100 service-card p-4 text-center">
            <div class="icon-container"><i class="{{ fields.field_beneficios_izq_icono ? fields.field_beneficios_izq_icono : 'fas fa-chart-line' }}"></i></div>
            <h3 class="card-title h5">{{ fields.field_beneficios_izq_titulo ? fields.field_beneficios_izq_titulo : 'Inversión' }}</h3>
            <p class="card-text small">{{ fields.field_beneficios_izq_descripcion ? fields.field_beneficios_izq_descripcion : 'Descripción del beneficio izquierdo.' }}</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 service-card p-4 text-center">
            <div class="icon-container"><i class="{{ fields.field_beneficios_centro_icon ? fields.field_beneficios_centro_icon : 'fas fa-handshake' }}"></i></div>
            <h3 class="card-title h5">{{ fields.field_beneficios_centro_titulo ? fields.field_beneficios_centro_titulo : 'Cooperación' }}</h3>
            <p class="card-text small">{{ fields.field_beneficios_centro_descripcion ? fields.field_beneficios_centro_descripcion : 'Descripción del beneficio central.' }}</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 service-card p-4 text-center">
            <div class="icon-container"><i class="{{ fields.field_beneficios_derecha_icon ? fields.field_beneficios_derecha_icon : 'fas fa-book-open' }}"></i></div>
            <h3 class="card-title h5">{{ fields.field_beneficios_derecha_titulo ? fields.field_beneficios_derecha_titulo : 'Conocimiento' }}</h3>
            <p class="card-text small">{{ fields.field_beneficios_derecha_descripcion ? fields.field_beneficios_derecha_descripcion : 'Descripción del beneficio derecho.' }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {# Historias Section (Placeholder structure from index.html) #}
  <section class="py-5 stories-section">
    <div class="container">
      <div class="section-header">
        <h2 class="text-uppercase">Historias que transforman</h2>
      </div>
      <div class="row align-items-center g-5 mt-4">
        <div class="col-lg-6">
          <div class="position-relative">
            <img src="https://acimedellin.org/wp-content/uploads/2023/11/Banner-Historias-Home.jpg" class="img-fluid rounded shadow" alt="Historias">
            <div class="btn btn-aci-primary position-absolute top-50 start-50 translate-middle rounded-circle shadow-lg" style="width: 70px; height: 70px; display: flex; align-items: center; justify-content: center;">
              <i class="fas fa-play"></i>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <h3 class="fw-bold mb-4" style="color: var(--aci-blue-dark);">Conoce el impacto de nuestra gestión</h3>
          <p class="mb-4">A través de testimonios reales, descubre cómo la cooperación internacional y la inversión extranjera contribuyen al crecimiento sostenible.</p>
          <ul class="list-unstyled mb-4">
            <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Desarrollo humano y social</li>
            <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> Transferencia de conocimiento</li>
          </ul>
          <a href="#" class="btn btn-aci-primary">VER TODAS LAS HISTORIAS</a>
        </div>
      </div>
    </div>
  </section>

  {# Allies Section #}
  <section class="py-5 bg-white">
    <div class="container text-center">
      <h2 class="text-uppercase fw-bold mb-5" style="color: var(--aci-blue-dark); font-size: 1.5rem;">Red de Aliados</h2>
      <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-4 align-items-center justify-content-center">
        <div class="col"><img src="https://acimedellin.org/wp-content/uploads/2021/05/Logo-ProColombia.png" class="ally-logo img-fluid" alt="ProColombia"></div>
        <div class="col"><img src="https://acimedellin.org/wp-content/uploads/2021/05/Logo-Invest-in-Colombia.png" class="ally-logo img-fluid" alt="Invest in Colombia"></div>
        <div class="col"><img src="https://acimedellin.org/wp-content/uploads/2021/05/Logo-Ruta-N.png" class="ally-logo img-fluid" alt="Ruta N"></div>
        <div class="col"><img src="https://acimedellin.org/wp-content/uploads/2021/05/Logo-CCM.png" class="ally-logo img-fluid" alt="Cámara de Comercio de Medellín"></div>
      </div>
    </div>
  </section>

  {# CTA Section #}
  <section class="zinco-cta-section py-5" style="background-color: var(--aci-blue-dark); color: white;">
    <div class="container text-center">
      <h2 class="mb-4 text-uppercase fw-bold">{{ fields.field_cta_titulo ? fields.field_cta_titulo : '¿Listo para transformar a Córdoba?' }}</h2>
      <p class="mb-5 opacity-75">{{ fields.field_cta_descripcion ? fields.field_cta_descripcion : 'Únete a nuestra plataforma y sé parte del cambio.' }}</p>
      <a href="{{ fields.field_cta_enlace_button ? fields.field_cta_enlace_button : '#' }}" class="btn btn-aci-primary btn-lg px-5">{{ fields.field_cta_label_button ? fields.field_cta_label_button : 'Regístrate' }}</a>
    </div>
  </section>

</div>