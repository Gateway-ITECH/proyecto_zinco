{#
/**
 * @file
 * Template for new recognition request notification to admins.
 *
 * Available variables:
 * - variables: Array of data (actor_name, actor_bundle_label, user_name, user_email, tipo_actor_solicitado, label, detail_url, admin_url).
 * - site_name: The name of the site.
 */
#}
<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #333; max-width: 620px; margin: 0 auto; border: 1px solid #e1e4e8; border-radius: 12px; overflow: hidden; background-color: #ffffff;">
  <!-- Header -->
  <div style="background: linear-gradient(135deg, #17a2b8 0%, #117a8b 100%); padding: 25px 20px; text-align: center; color: white;">
    <h1 style="margin: 0; font-size: 22px; font-weight: 700;">{{ 'Nueva Solicitud de Reconocimiento'|t }}</h1>
    <p style="margin: 6px 0 0; opacity: 0.9; font-size: 14px;">{{ site_name }}</p>
  </div>
  
  <!-- Body -->
  <div style="padding: 30px 25px;">
    <p style="font-size: 15px; margin-top: 0; color: #495057;">
      {{ 'Se ha registrado una nueva solicitud de reconocimiento en la plataforma que requiere revisión y acción administrativa:'|t }}
    </p>
    
    <div style="background-color: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 20px; margin: 20px 0; font-size: 14px;">
      <div style="margin-bottom: 10px;">
        <strong style="color: #495057;">{{ 'Usuario Originador:'|t }}</strong>
        <span style="color: #212529; font-weight: 600;">{{ variables.user_name }}</span>
        {% if variables.user_email and variables.user_email != 'No disponible' %}
          <span style="color: #6c757d;">({{ variables.user_email }})</span>
        {% endif %}
      </div>

      <div style="margin-bottom: 10px;">
        <strong style="color: #495057;">{{ 'Actor Solicitante:'|t }}</strong>
        <span style="color: #212529;">{{ variables.actor_name }}</span>
        {% if variables.actor_bundle_label %}
          <span style="color: #6c757d; font-size: 13px;">({{ variables.actor_bundle_label }})</span>
        {% endif %}
      </div>

      <div style="margin-bottom: 10px;">
        <strong style="color: #495057;">{{ 'Tipo de Actor Solicitado:'|t }}</strong>
        <span style="background-color: #d1e7dd; color: #0f5132; padding: 3px 10px; border-radius: 4px; font-weight: 700;">
          {{ variables.tipo_actor_solicitado }}
        </span>
      </div>

      <div>
        <strong style="color: #495057;">{{ 'Asunto / Título:'|t }}</strong>
        <span style="color: #212529;">{{ variables.label }}</span>
      </div>
    </div>
    
    <div style="text-align: center; margin-top: 30px;">
      <a href="{{ variables.detail_url }}" style="background-color: #28a745; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold; font-size: 14px; display: inline-block; margin-right: 8px; margin-bottom: 8px;">
        {{ 'Ver Detalle y Gestionar'|t }}
      </a>
      {% if variables.admin_url %}
        <a href="{{ variables.admin_url }}" style="background-color: #4e73df; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold; font-size: 14px; display: inline-block; margin-bottom: 8px;">
          {{ 'Panel de Solicitudes'|t }}
        </a>
      {% endif %}
    </div>
  </div>
  
  <!-- Footer -->
  <div style="background-color: #f8f9fa; border-top: 1px solid #e9ecef; padding: 15px 20px; text-align: center; font-size: 12px; color: #868e96;">
    <p style="margin: 0;">&copy; {{ "now"|date("Y") }} {{ site_name }}. {{ 'Todos los derechos reservados.'|t }}</p>
  </div>
</div>
