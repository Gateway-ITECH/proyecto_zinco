{#
/**
 * @file
 * Default theme implementation for Zinco Actor creation form by bundle.
 *
 * Available variables:
 * - actor_form: The renderable array of the actor creation form.
 * - bundle_label: The human-readable label of the actor bundle.
 */
#}
<div class="zinco-actor-form-by-bundle-container py-4" style="padding-left: 80px; padding-right: 80px;">
  <div class="mb-4">
    <h2 class="fw-bold mb-1">{{ 'Crear nuevo actor de tipo'|t }} {{ bundle_label }}</h2>
    <p class="text-muted small">{{ 'Completa la información requerida para registrar este nuevo perfil de actor en la plataforma ZINCO.'|t }}</p>
  </div>
  {{ actor_form }}
</div>

<style>
  .zinco-actor-form-by-bundle-container .form-type-checkbox,
  .zinco-actor-form-by-bundle-container .form-check,
  .zinco-actor-form-by-bundle-container .form-item-aceptar-terminos {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding: 1rem 1.25rem;
    background-color: #f8fff9;
    border: 1.5px solid #c3e6cb;
    border-radius: 10px;
    box-shadow: 0 2px 4px rgba(40, 167, 69, 0.06);
  }

  .zinco-actor-form-by-bundle-container .form-type-checkbox label,
  .zinco-actor-form-by-bundle-container .form-check label,
  .zinco-actor-form-by-bundle-container .form-item-aceptar-terminos label {
    font-weight: 600;
    color: #155724;
    cursor: pointer;
  }

  .zinco-actor-form-by-bundle-container .form-type-checkbox input[type="checkbox"],
  .zinco-actor-form-by-bundle-container .form-check input[type="checkbox"],
  .zinco-actor-form-by-bundle-container .form-item-aceptar-terminos input[type="checkbox"] {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: #28a745;
    margin-right: 0.6rem;
    vertical-align: middle;
    cursor: pointer;
  }

  .zinco-actor-form-by-bundle-container .description,
  .zinco-actor-form-by-bundle-container small.text-muted,
  .zinco-actor-form-by-bundle-container .form-item--description {
    display: block !important;
    font-size: 0.85rem;
    color: #555 !important;
    margin-top: 0.5rem;
    line-height: 1.5;
  }
</style>
