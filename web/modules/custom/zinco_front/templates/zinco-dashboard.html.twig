{#
/**
 * @file
 * Zinco Front dashboard page.
 *
 * Available variables:
 * - test_var: A variable passed from the controller.
 */
#}
<div class="zinco-dashboard-header d-flex justify-content-between align-items-center mb-4">
  <div class="zinco-dashboard-title-section">
    <h1 class="h3">Dashboard centralizado</h1>
    <p class="text-muted mb-0">Exploración visual de la producción científica, tecnológica e innovadora de Córdoba.</p>
  </div>
  <div class="zinco-dashboard-actions">
    <button class="btn btn-outline-secondary"><span class="icon-filter-slash me-2"></span> Limpiar Filtros</button>
  </div>
</div>

<div class="zinco-dashboard-filters mb-4">
  <div class="row">
    <div class="col-md-4">
      <div class="form-group">
        <label for="municipio-select">Municipio</label>
        <select class="form-select" id="municipio-select">
          <option selected>Seleccione una opción...</option>
          <!-- Opciones de municipio -->
        </select>
      </div>
    </div>
    <div class="col-md-4">
      <div class="form-group">
        <label for="sector-select">Sector</label>
        <select class="form-select" id="sector-select">
          <option selected>Seleccione una opción...</option>
          <!-- Opciones de sector -->
        </select>
      </div>
    </div>
    <div class="col-md-4">
      <div class="form-group">
        <label for="tecnologias-select">Tecnologías 4.0</label>
        <select class="form-select" id="tecnologias-select">
          <option selected>Seleccione una opción...</option>
          <!-- Opciones de tecnologías 4.0 -->
        </select>
      </div>
    </div>
  </div>
</div>

<div class="zinco-dashboard-cards mb-4">
  <div class="row">
    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="card-title text-muted text-uppercase mb-0">Producción Total</h6>
            <span class="icon-clipboard-check text-muted"></span>
          </div>
          <h3 class="card-text mb-1">178</h3>
          <p class="card-text text-success small"><span class="icon-arrow-up me-1"></span>8.5% vs. período anterior</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="card-title text-muted text-uppercase mb-0">Propiedad Intelectual</h6>
            <span class="icon-award text-muted"></span>
          </div>
          <h3 class="card-text mb-1">21</h3>
          <p class="card-text text-danger small"><span class="icon-arrow-down me-1"></span>-3.1% vs. período anterior</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="card-title text-muted text-uppercase mb-0">Desarrollo Tecnológico</h6>
            <span class="icon-code text-muted"></span>
          </div>
          <h3 class="card-text mb-1">52</h3>
          <p class="card-text text-success small"><span class="icon-arrow-up me-1"></span>12.8% vs. período anterior</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="card-title text-muted text-uppercase mb-0">Tesis Dirigidas</h6>
            <span class="icon-graduation-cap text-muted"></span>
          </div>
          <h3 class="card-text mb-1">15</h3>
          <p class="card-text text-muted small"><span class="icon-arrow-right me-1"></span>-0.2% vs. período anterior</p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="zinco-dashboard-additional-cards mb-4">
  <div class="row">
    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="card-title text-muted text-uppercase mb-0">Grupos de Investigación (MINCIENCIAS)</h6>
            <!-- Icono para Grupos de Investigación -->
          </div>
          <h3 class="card-text mb-1">128</h3>
          <p class="card-text text-success small"><span class="icon-chart-line me-1"></span>+8%<br>vs. año anterior</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="card-title text-muted text-uppercase mb-0">Investigadores Reconocidos (MINCIENCIAS)</h6>
            <!-- Icono para Investigadores Reconocidos -->
          </div>
          <h3 class="card-text mb-1">452</h3>
          <p class="card-text text-success small"><span class="icon-chart-line me-1"></span>+12%<br>vs. año anterior</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="card-title text-muted text-uppercase mb-0">Centros de Investigación Activos</h6>
            <!-- Icono para Centros de Investigación Activos -->
          </div>
          <h3 class="card-text mb-1">15</h3>
          <p class="card-text text-muted small"><span class="icon-arrow-right me-1"></span>Estable<br>vs. año anterior</p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="zinco-dashboard-progress-cards mb-4">
  <div class="row">
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6 class="card-title text-muted text-uppercase mb-0">Centros de Desarrollo Tecnológico (CDT)</h6>
          <p class="text-muted small mb-3">Activos en Córdoba</p>
          <h3 class="card-text text-primary mb-3">8</h3>
          <div class="progress mb-2" style="height: 8px;">
            <div class="progress-bar bg-primary" role="progressbar" style="width: 75%;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
          </div>
          <div class="d-flex justify-content-between small text-muted">
            <span>Meta Anual (10)</span>
            <span>75% alcanzado</span>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6 class="card-title text-muted text-uppercase mb-0">Centros de Innovación (Públicos/Privados)</h6>
          <p class="text-muted small mb-3">Activos en Córdoba</p>
          <h3 class="card-text text-warning mb-3">12</h3>
          <div class="progress mb-2" style="height: 8px;">
            <div class="progress-bar bg-warning" role="progressbar" style="width: 60%;" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100"></div>
          </div>
          <div class="d-flex justify-content-between small text-muted">
            <span>Meta Anual (20)</span>
            <span>60% alcanzado</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="zinco-dashboard-charts mb-4">
  <div class="row">
    <div class="col-md-6">
      <div class="card shadow-sm chart-card-height">
        <div class="card-body">
          <h5 class="card-title">Egresados por Nivel Académico</h5>
          <canvas id="academicLevelChart"></canvas>
          <div class="d-flex justify-content-around mt-3">
            <div class="text-center">
              <span class="badge rounded-pill" style="background-color: #007bff;">1200</span>
              <small class="d-block text-muted">Técnico</small>
            </div>
            <div class="text-center">
              <span class="badge rounded-pill" style="background-color: #ffc107;">1850</span>
              <small class="d-block text-muted">Tecnólogo</small>
            </div>
            <div class="text-center">
              <span class="badge rounded-pill" style="background-color: #28a745;">3200</span>
              <small class="d-block text-muted">Universitario</small>
            </div>
            <div class="text-center">
              <span class="badge rounded-pill" style="background-color: #dc3545;">850</span>
              <small class="d-block text-muted">Posgrado</small>
            </div>
            <div class="text-center">
              <span class="badge rounded-pill" style="background-color: #6f42c1;">450</span>
              <small class="d-block text-muted">Maestría</small>
            </div>
            <div class="text-center">
              <span class="badge rounded-pill" style="background-color: #6c757d;">150</span>
              <small class="d-block text-muted">Doctorado</small>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card shadow-sm chart-card-height">
        <div class="card-body">
          <h5 class="card-title">Actores por Municipio</h5>
          <canvas id="municipioChart"></canvas>
          <div class="mt-3">
            <div class="d-flex align-items-center mb-2">
              <div class="progress flex-grow-1 me-2" style="height: 15px;">
                <div class="progress-bar bg-primary" role="progressbar" style="width: 65%;" aria-valuenow="65" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <span class="text-muted">Montería (65)</span>
            </div>
            <div class="d-flex align-items-center mb-2">
              <div class="progress flex-grow-1 me-2" style="height: 15px;">
                <div class="progress-bar bg-warning" role="progressbar" style="width: 41%;" aria-valuenow="41" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <span class="text-muted">Cereté (41)</span>
            </div>
            <div class="d-flex align-items-center mb-2">
              <div class="progress flex-grow-1 me-2" style="height: 15px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: 31%;" aria-valuenow="31" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <span class="text-muted">Lorica (31)</span>
            </div>
            <div class="d-flex align-items-center mb-2">
              <div class="progress flex-grow-1 me-2" style="height: 15px;">
                <div class="progress-bar bg-danger" role="progressbar" style="width: 22%;" aria-valuenow="22" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <span class="text-muted">Sahagún (22)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
