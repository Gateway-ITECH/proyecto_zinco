{#
/**
 * @file
 * Custom block for user menu and notifications.
 *
 * Available variables:
 * - logged_in: Boolean indicating if the user is logged in.
 * - user_name: The display name of the current user.
 * - user_picture: The URL of the user's profile picture.
 * - unread_notifications: The count of unread notifications.
 * - logout_url: The URL for logging out.
 */
#}

{% if logged_in %}
  <div class="user-menu-block d-flex align-items-center">
    {# Notification Icon #}
    <div class="dropdown notification-dropdown mr-3">
      <a class="nav-link dropdown-toggle" href="#" role="button" id="notificationsDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        <span class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width:32px; height:32px;">
          <i class="fas fa-bell text-secondary"></i>
        </span>
        {% if unread_notifications > 0 %}
          <span class="badge badge-danger notification-count">{{ unread_notifications }}</span>
        {% endif %}
      </a>
      <div class="dropdown-menu dropdown-menu-right" aria-labelledby="notificationsDropdown">
        <h6 class="dropdown-header">Notificaciones</h6>
        {# Placeholder for notification items #}
        <a class="dropdown-item" href="#">No tienes notificaciones nuevas.</a>
        
      </div>
    </div>

    {# User Profile Picture and Dropdown #}
    <div class="dropdown user-profile-dropdown ps-2">
      <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" id="userDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        {% if user_picture %}
          <span class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width:32px; height:32px;">
            <img src="{{ user_picture }}" alt="{{ user_name }}" class="rounded-circle user-avatar" width="28" height="28">
          </span>
        {% else %}
          <span class="bg-secondary rounded-circle d-flex align-items-center justify-content-center" style="width:32px; height:32px;">
            <i class="fas fa-user text-white"></i>
          </span>
        {% endif %}
      </a>
      <div class="dropdown-menu dropdown-menu-right" aria-labelledby="userDropdown">
        <h6 class="dropdown-header">{{ user_name }}</h6>
        <a class="dropdown-item" href="#">Mi Perfil</a>
        <a class="dropdown-item" href="#">Configuración</a>
        <div class="dropdown-divider"></div>
        <a class="dropdown-item" href="{{ logout_url }}">Cerrar Sesión</a>
      </div>
    </div>
  </div>
{% endif %}