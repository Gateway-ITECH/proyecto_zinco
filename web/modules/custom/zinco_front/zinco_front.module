/**
 * Implements hook_user_update().
 */
function zinco_front_user_update(UserInterface $account) {
  // Invalidate the user data cache when a user is updated.
  var_dump($account->getCacheTags());
  \Drupal::service('cache_tags.invalidator')->invalidateTags($account->getCacheTags());
}
/**
 * Implements hook_form_alter().
 */
function zinco_front_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $form_object = $form_state->getFormObject();

  if ($form_id == 'user_form') {
    $current_user = \Drupal::currentUser();
    $roles = $current_user->getRoles();
    if (in_array('actor_registrado', $roles)) {
      if (!$form_object->getEntity()->isNew()) {
        \Drupal::request()->query->set('destination', '/dashboard');
      }
    }
  }


    // 1. Verifica que estamos en la operación 'frontend_add' de tu entidad.
    if (get_class($form_object) === 'Drupal\zinco_retos_soluciones\Form\ZincoRetosSolucionesForm' && 
        $form_object->getOperation() === 'frontend_add') 
    {
        // 2. Agrega el nuevo método al final del array de submit handlers.
        // La sintaxis '::customFrontendRedirect' indica que es un método del objeto formulario.

    }
  

  // Agregar botón al campo actores registrados en el tipo de contenido landing page config.
  if (in_array($form_id, ['node_landing_page_config_form', 'node_landing_page_config_edit_form'])) {
    if (isset($form['field_actores_registrados'])) {
      // Creamos un contenedor para agrupar el campo y el botón de forma vertical.
      $form['field_actores_registrados_container'] = [
        '#type' => 'container',
        '#attributes' => [
          'class' => ['field-actores-registrados-container'],
          'id' => 'field-actores-registrados-ajax-wrapper',
        ],
        '#weight' => $form['field_actores_registrados']['#weight'],
      ];

      // Movemos el campo dentro del contenedor con peso menor.
      $form['field_actores_registrados_container']['field_actores_registrados'] = $form['field_actores_registrados'];
      $form['field_actores_registrados_container']['field_actores_registrados']['#weight'] = 0;

      // Agregamos un hipervínculo en vez de un botón.
      $form['field_actores_registrados_container']['btn_gestionar_actores'] = [
        '#type' => 'link',
        '#title' => t('Total Actores'),
        '#url' => \Drupal\Core\Url::fromRoute('<current>'),
        '#weight' => 10,
        '#attributes' => [
          'id' => 'btn-gestionar-actores-link',
          'class' => ['gestionar-actores-link'],
          'style' => 'margin-top: 10px; display: inline-block; cursor: pointer; text-decoration: underline;',
          'data-endpoint' => \Drupal\Core\Url::fromRoute('zinco_front.get_actors_count')->toString(),
        ],
      ];

      // Eliminamos el campo del nivel superior.
      unset($form['field_actores_registrados']);
    }

    if (isset($form['field_proyectos_activos'])) {
      $form['field_proyectos_activos_container'] = [
        '#type' => 'container',
        '#attributes' => [
          'class' => ['field-proyectos-activos-container'],
        ],
        '#weight' => $form['field_proyectos_activos']['#weight'],
      ];

      $form['field_proyectos_activos_container']['field_proyectos_activos'] = $form['field_proyectos_activos'];
      $form['field_proyectos_activos_container']['field_proyectos_activos']['#weight'] = 0;

      $form['field_proyectos_activos_container']['btn_gestionar_proyectos'] = [
        '#type' => 'link',
        '#title' => t('Total Proyectos'),
        '#url' => \Drupal\Core\Url::fromRoute('<current>'),
        '#weight' => 10,
        '#attributes' => [
          'id' => 'btn-gestionar-proyectos-link',
          'class' => ['gestionar-actores-link'],
          'style' => 'margin-top: 10px; display: inline-block; cursor: pointer; text-decoration: underline;',
          'data-endpoint' => \Drupal\Core\Url::fromRoute('zinco_front.get_projects_count')->toString(),
        ],
      ];

      unset($form['field_proyectos_activos']);
    }

    // Agregar enlace a iconos de FontAwesome para proteger campos específicos.
    $icon_fields = [
      'field_actores_registrados_icon',
      'field_beneficios_centro_icon',
      'field_beneficios_derecha_icon',
      'field_beneficios_izq_icono',
      'field_colaboraciones_icon',
      'field_herramientas_centro_icon',
      'field_herramientas_derecha_icon',
      'field_herramientas_izq_icon',
      'field_proyectos_activos_icon',
    ];

    foreach ($icon_fields as $field_name) {
      if (isset($form[$field_name])) {
        $form[$field_name]['#suffix'] = '<div class="icon-help-link" style="margin-top: 5px;"><a href="https://fontawesome.com/v5/search?ic=free-collection" target="_blank" style="text-decoration: underline; font-size: 0.9em;">' . t('Ver iconos disponibles (FontAwesome v5 Free)') . '</a></div>';
      }
    }

    // Cargamos nuestra librería personalizada con Vanilla JS.
    $form['#attached']['library'][] = 'zinco_front/zinco-gestionar-actores';
  }
}


/**
 * Implements hook_form_views_exposed_form_alter().
 */
function zinco_front_form_views_exposed_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $view = $form_state->get('view');
  if (
    $view->id() == 'listas_de_data' ||
    $view->id() == 'dashboard_investigadores' ||
    $view->id() == 'dashboard_organizaciones_intermedias' ||
    $view->id() == 'articulos_de_investigacion' ||
    $view->id() == 'dashboard_investigadores' ||
    $view->id() == 'dashboard_instancias_orientacion_politica' ||
    $view->id() == 'dashboard_entidades_gobierno' ||
    $view->id() == 'dashboard_instituciones_academicas' ||
    $view->id() == 'dashboard_programas_academicos' ||
    $view->id() == 'dashboard_patentes' ||
    $view->id() == 'dashboard_productos_tecnologicos' ||
    $view->id() == 'dashboard_registros_software'
  ) {
    if (isset($form['municipio'])) {
      $form['municipio']['#type'] = 'select';
      
      $options = ['' => '- Todos -'];
      $entity_type_manager = \Drupal::entityTypeManager();
      $term_storage = $entity_type_manager->getStorage('taxonomy_term');
      
      // Load 'Córdoba' term from 'divipola'
      $properties = [
        'name' => 'Córdoba', 
        'vid' => 'divipola'
      ];
      $terms = $term_storage->loadByProperties($properties);
      
      if ($terms) {
        $parent_term = reset($terms);
        $children = $term_storage->loadChildren($parent_term->id());
        
        foreach ($children as $child) {
          $options[$child->label()] = $child->label();
        }
      }

      $form['municipio']['#options'] = $options;
      $form['municipio']['#size'] = 1;
    }

    if (isset($form['sector'])) {
      $form['sector']['#type'] = 'select';
      $options = ['' => '- Todos -'];
      
      $entity_type_manager = \Drupal::entityTypeManager();
      $term_storage = $entity_type_manager->getStorage('taxonomy_term');
      $terms = $term_storage->loadByProperties(['vid' => 'sectores_clave']);
      
      foreach ($terms as $term) {
        $options[$term->label()] = $term->label();
      }
      
      $form['sector']['#options'] = $options;
      $form['sector']['#size'] = 1;
    }

    if (isset($form['tecnologia40'])) {
      $form['tecnologia40']['#type'] = 'select';
      $options = ['' => '- Todos -'];
      
      $entity_type_manager = \Drupal::entityTypeManager();
      $term_storage = $entity_type_manager->getStorage('taxonomy_term');
      $terms = $term_storage->loadByProperties(['vid' => 'tecnologias_clave']);
      
      foreach ($terms as $term) {
        $options[$term->label()] = $term->label();
      }
      
      $form['tecnologia40']['#options'] = $options;
      $form['tecnologia40']['#size'] = 1;
    }
  }

  if ($view->id() == 'listas_de_data') {
    if (isset($form['categoria_minciencias'])) {
      $form['categoria_minciencias']['#type'] = 'select';
      $options = ['' => '- Todos -'];
      
      $entity_type_manager = \Drupal::entityTypeManager();
      $term_storage = $entity_type_manager->getStorage('taxonomy_term');
      $terms = $term_storage->loadByProperties(['vid' => 'categorias_grupos_de_investigaci']);
      
      foreach ($terms as $term) {
        $options[$term->label()] = $term->label();
      }
      
      $form['categoria_minciencias']['#options'] = $options;
      $form['categoria_minciencias']['#size'] = 1;
    }
  }

  if ($view->id() == 'dashboard_investigadores') {
    if (isset($form['nme_clasificacion_pr'])) {
      $form['nme_clasificacion_pr']['#type'] = 'select';
      $options = ['' => '- Todos -'];
      
      $entity_type_manager = \Drupal::entityTypeManager();
      $term_storage = $entity_type_manager->getStorage('taxonomy_term');
      $terms = $term_storage->loadByProperties(['vid' => 'clasificacion_de_investigadores']);
      
      foreach ($terms as $term) {
        $options[$term->label()] = $term->label();
      }
      
      $form['nme_clasificacion_pr']['#options'] = $options;
      $form['nme_clasificacion_pr']['#size'] = 1;
    }
  }
}

/**
 * Implements hook_mail().
 */
function zinco_front_mail($key, &$message, $params) {
  switch ($key) {
    case 'call_for_papers':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = $params['subject'];
      $message['body'][] = $params['message'];
      break;

    case 'templated_email':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = $params['subject'];
      $message['body'][] = $params['body'];
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
      break;
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for zinco_retos_innovacion.
 */
function zinco_front_zinco_retos_innovacion_insert(\Drupal\Core\Entity\EntityInterface $entity) {
  _zinco_front_notify_organizers_on_publish($entity);
}

/**
 * Implements hook_ENTITY_TYPE_update() for zinco_retos_innovacion.
 */
function zinco_front_zinco_retos_innovacion_update(\Drupal\Core\Entity\EntityInterface $entity) {
  // Check if status changed from false to true.
  $original = $entity->original;
  if ($original && !$original->get('status')->value && $entity->get('status')->value) {
    _zinco_front_notify_organizers_on_publish($entity);
  }
}

/**
 * Helper function to notify organizers when a reto is published.
 */
function _zinco_front_notify_organizers_on_publish(\Drupal\Core\Entity\EntityInterface $entity) {
  // Only proceed if the reto is published (status = true).
  if (!$entity->get('status')->value) {
    return;
  }

  if ($entity->hasField('organizador_reto') && !$entity->get('organizador_reto')->isEmpty()) {
    $actor_ids = array_column($entity->get('organizador_reto')->getValue(), 'target_id');
    
    // Find users associated with these actors.
    $query = \Drupal::entityQuery('user')
      ->condition('status', 1)
      ->condition('field_actor', $actor_ids, 'IN')
      ->accessCheck(FALSE);
    
    $uids = $query->execute();
    
    if (!empty($uids)) {
      $users = \Drupal\user\Entity\User::loadMultiple($uids);
      $mail_service = \Drupal::service('zinco_front.mail_service');
      $base_url = \Drupal::request()->getSchemeAndHttpHost();
      
      $variables = [
        'reto_label' => $entity->label(),
        'created_date' => \Drupal::service('date.formatter')->format(\Drupal::time()->getRequestTime(), 'custom', 'd/m/Y'),
        'base_url' => $base_url,
        'reto_url' => '/retos/' . $entity->id(),
      ];
      
      foreach ($users as $user) {
        if ($email = $user->getEmail()) {
          $variables['author_name'] = $user->getDisplayName();
          $mail_service->sendTemplatedEmail(
            $email,
            'Tu Reto de Innovación ha sido publicado: ' . $entity->label(),
            'email_reto_publicado', 
            $variables
          );
        }
      }
    }
  }
}



/**
 * Implements hook_ENTITY_TYPE_update() for zinco_retos_soluciones.
 */
function zinco_front_zinco_retos_soluciones_update(\Drupal\Core\Entity\EntityInterface $entity) {
  $original = $entity->original;
  // Trigger notification when status changes from false to true (validated).
  if ($original && !$original->get('status')->value && $entity->get('status')->value) {
    _zinco_front_notify_solution_validated($entity);
  }
}

/**
 * Helper function to notify authors and reto organizers when a solution is validated.
 */
function _zinco_front_notify_solution_validated(\Drupal\Core\Entity\EntityInterface $solution) {
  $mail_service = \Drupal::service('zinco_front.mail_service');
  $base_url = \Drupal::request()->getSchemeAndHttpHost();
  $date_formatter = \Drupal::service('date.formatter');

  // 1. Prepare common variables.
  $reto_label = '';
  $reto_entity = NULL;
  if ($solution->hasField('field_reto_asociado') && !$solution->get('field_reto_asociado')->isEmpty()) {
    $reto_entity = $solution->get('field_reto_asociado')->entity;
    if ($reto_entity) {
      $reto_label = $reto_entity->label();
    }
  }

  $variables = [
    'solution_label' => $solution->label(),
    'reto_label' => $reto_label,
    'validated_date' => $date_formatter->format(\Drupal::time()->getRequestTime(), 'custom', 'd/m/Y'),
    'base_url' => $base_url,
    'solution_url' => '/retos/detalle/' . $solution->id(),
  ];

  // 2. Notify Solution Authors.
  if ($solution->hasField('field_autores_solucion') && !$solution->get('field_autores_solucion')->isEmpty()) {
    $actor_ids = array_column($solution->get('field_autores_solucion')->getValue(), 'target_id');
    $author_users = _zinco_front_get_users_from_actors($actor_ids);

    foreach ($author_users as $user) {
      if ($email = $user->getEmail()) {
        $variables['author_name'] = $user->getDisplayName();
        $mail_service->sendTemplatedEmail(
          $email,
          'Tu postulación ha sido validada: ' . $solution->label(),
          'email_solution_validated_author',
          $variables
        );
      }
    }
  }

  // 3. Notify Reto Organizers.
  if ($reto_entity && $reto_entity->hasField('organizador_reto') && !$reto_entity->get('organizador_reto')->isEmpty()) {
    $reto_actor_ids = array_column($reto_entity->get('organizador_reto')->getValue(), 'target_id');
    $organizer_users = _zinco_front_get_users_from_actors($reto_actor_ids);

    foreach ($organizer_users as $user) {
      if ($email = $user->getEmail()) {
        $variables['author_name'] = $user->getDisplayName();
        $mail_service->sendTemplatedEmail(
          $email,
          'Nueva postulación recibida para tu reto: ' . $reto_label,
          'email_solution_validated_organizer',
          $variables
        );
      }
    }
  }
}

/**
 * Helper function to find users associated with actor IDs.
 */
function _zinco_front_get_users_from_actors(array $actor_ids) {
  if (empty($actor_ids)) {
    return [];
  }
  $query = \Drupal::entityQuery('user')
    ->condition('status', 1)
    ->condition('field_actor', $actor_ids, 'IN')
    ->accessCheck(FALSE);
  $uids = $query->execute();
  return !empty($uids) ? \Drupal\user\Entity\User::loadMultiple($uids) : [];
}
