/**
 * Implements hook_user_update().
 */
function zinco_front_user_update(UserInterface $account) {
  // Invalidate the user data cache when a user is updated.
  var_dump($account->getCacheTags());
  \Drupal::service('cache_tags.invalidator')->invalidateTags($account->getCacheTags());
}
/**
 * Implements hook_form_alter().
 */
function zinco_front_form_alter($form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $form_object = $form_state->getFormObject();

    // 1. Verifica que estamos en la operación 'frontend_add' de tu entidad.
    if (get_class($form_object) === 'Drupal\zinco_retos_soluciones\Form\ZincoRetosSolucionesForm' && 
        $form_object->getOperation() === 'frontend_add') 
    {
        // 2. Agrega el nuevo método al final del array de submit handlers.
        // La sintaxis '::customFrontendRedirect' indica que es un método del objeto formulario.

    }
}


  







