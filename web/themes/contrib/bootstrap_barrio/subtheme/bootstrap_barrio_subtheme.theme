<?php

/**
 * @file
 * Functions to support theming in the SASS Starterkit subtheme.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\file\Entity\File;

/**
 * Implements hook_form_system_theme_settings_alter() for settings form.
 *
 * Replace Barrio setting options with subtheme ones and add secondary logo settings.
 */
function bootstrap_barrio_subtheme_form_system_theme_settings_alter(&$form, FormStateInterface $form_state) {
  $form['components']['navbar']['bootstrap_barrio_navbar_top_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
  $form['components']['navbar']['bootstrap_barrio_navbar_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];

  // Configuración de Logotipo Secundario e Hipervínculo.
  $form['secondary_logo_fieldset'] = [
    '#type' => 'details',
    '#title' => t('Logotipo Secundario con Hipervínculo'),
    '#description' => t('Permite mostrar un segundo logotipo institucional con su propio hipervínculo al lado del logotipo principal del sitio (Unicórdoba).'),
    '#open' => TRUE,
    '#weight' => -9,
  ];

  $form['secondary_logo_fieldset']['secondary_logo_enable'] = [
    '#type' => 'checkbox',
    '#title' => t('Habilitar logotipo secundario'),
    '#description' => t('Marque esta casilla para mostrar el segundo logotipo en el encabezado.'),
    '#default_value' => theme_get_setting('secondary_logo_enable', 'bootstrap_barrio_subtheme') ?? FALSE,
  ];

  $form['secondary_logo_fieldset']['secondary_logo_url'] = [
    '#type' => 'textfield',
    '#title' => t('Hipervínculo / Enlace del logotipo secundario'),
    '#description' => t('URL a la que redirigirá al hacer clic en el logotipo secundario (ej. https://minciencias.gov.co o /inicio).'),
    '#default_value' => theme_get_setting('secondary_logo_url', 'bootstrap_barrio_subtheme') ?? '',
  ];

  $form['secondary_logo_fieldset']['secondary_logo_target_blank'] = [
    '#type' => 'checkbox',
    '#title' => t('Abrir hipervínculo en una pestaña nueva'),
    '#description' => t('Añade target="_blank" al hipervínculo.'),
    '#default_value' => theme_get_setting('secondary_logo_target_blank', 'bootstrap_barrio_subtheme') ?? TRUE,
  ];

  $form['secondary_logo_fieldset']['secondary_logo_alt'] = [
    '#type' => 'textfield',
    '#title' => t('Texto alternativo (Alt / Título)'),
    '#description' => t('Texto descriptivo para accesibilidad e información al pasar el cursor.'),
    '#default_value' => theme_get_setting('secondary_logo_alt', 'bootstrap_barrio_subtheme') ?? '',
  ];

  $form['secondary_logo_fieldset']['secondary_logo_image'] = [
    '#type' => 'managed_file',
    '#title' => t('Subir imagen del logotipo secundario'),
    '#description' => t('Suba un archivo de imagen (formatos: png, svg, jpg, jpeg, webp).'),
    '#upload_location' => 'public://logos/',
    '#upload_validators' => [
      'FileExtension' => ['extensions' => 'png gif jpg jpeg svg webp'],
    ],
    '#default_value' => theme_get_setting('secondary_logo_image', 'bootstrap_barrio_subtheme') ? (array) theme_get_setting('secondary_logo_image', 'bootstrap_barrio_subtheme') : [],
  ];

  $form['secondary_logo_fieldset']['secondary_logo_path'] = [
    '#type' => 'textfield',
    '#title' => t('O ruta/URL externa de la imagen'),
    '#description' => t('Ruta local (ej. public://logos/mi-logo.png o /themes/...) o URL externa (https://...). Si sube un archivo arriba, ese tendrá prioridad.'),
    '#default_value' => theme_get_setting('secondary_logo_path', 'bootstrap_barrio_subtheme') ?? '',
  ];

  $form['#submit'][] = 'bootstrap_barrio_subtheme_theme_settings_submit';
}

/**
 * Submit handler for secondary logo in theme settings.
 */
function bootstrap_barrio_subtheme_theme_settings_submit(&$form, FormStateInterface $form_state) {
  $fids = $form_state->getValue('secondary_logo_image');
  if (!empty($fids)) {
    $fid = is_array($fids) ? reset($fids) : $fids;
    if ($fid) {
      $file = File::load($fid);
      if ($file) {
        $file->setPermanent();
        $file->save();
        \Drupal::service('file.usage')->add($file, 'bootstrap_barrio_subtheme', 'theme', 1);
      }
    }
  }
}

/**
 * Helper function to retrieve secondary logo configuration and resolved image URL.
 *
 * @return array
 *   Array with secondary logo attributes.
 */
function _bootstrap_barrio_subtheme_get_secondary_logo_data() {
  $theme = 'bootstrap_barrio_subtheme';
  $enable = (bool) theme_get_setting('secondary_logo_enable', $theme);

  $data = [
    'secondary_logo_enable' => $enable,
    'secondary_logo_image' => '',
    'secondary_logo_url' => (string) (theme_get_setting('secondary_logo_url', $theme) ?: ''),
    'secondary_logo_alt' => (string) (theme_get_setting('secondary_logo_alt', $theme) ?: 'Logo secundario'),
    'secondary_logo_target_blank' => theme_get_setting('secondary_logo_target_blank', $theme) ?? TRUE,
  ];

  if ($enable) {
    $image_url = '';
    $fids = theme_get_setting('secondary_logo_image', $theme);
    if (!empty($fids)) {
      $fid = is_array($fids) ? reset($fids) : $fids;
      if ($fid) {
        $file = File::load($fid);
        if ($file) {
          $image_url = \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
        }
      }
    }

    if (empty($image_url)) {
      $path = theme_get_setting('secondary_logo_path', $theme);
      if (!empty($path)) {
        if (str_starts_with($path, 'http://') || str_starts_with($path, 'https://') || str_starts_with($path, '//')) {
          $image_url = $path;
        }
        elseif (str_starts_with($path, 'public://')) {
          $image_url = \Drupal::service('file_url_generator')->generateAbsoluteString($path);
        }
        else {
          $image_url = base_path() . ltrim($path, '/');
        }
      }
    }

    $data['secondary_logo_image'] = $image_url;
  }

  return $data;
}

/**
 * Implements hook_preprocess_block() for branding block.
 */
function bootstrap_barrio_subtheme_preprocess_block(&$variables) {
  if (isset($variables['plugin_id']) && $variables['plugin_id'] === 'system_branding_block') {
    $logo_data = _bootstrap_barrio_subtheme_get_secondary_logo_data();
    foreach ($logo_data as $key => $value) {
      $variables[$key] = $value;
    }
  }
}

/**
 * Implements hook_preprocess_html() for html.html.twig.
 */
function bootstrap_barrio_subtheme_preprocess_html(&$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'zinco_front.landing_page') {
    $variables['attributes']['class'][] = 'is-landing-page';
  }
}

/**
 * Implements hook_preprocess_page() for page.html.twig.
 */
function bootstrap_barrio_subtheme_preprocess_page(&$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();

  // Detectar si estamos en landing page.
  $variables['is_landing_page'] = ($route_name === 'zinco_front.landing_page');

  // Detectar si estamos en un formulario de creación o edición de entidad (nodo u otros tipos).
  $is_form = FALSE;
  
  if (isset($route_name)) {
    // Patrones comunes para formularios en Drupal, rutas de usuario, vistas y nodos
    $user_routes = ['user.login', 'user.register', 'user.pass', 'user.reset'];
    if (strpos($route_name, '.add') !== FALSE || strpos($route_name, '.edit') !== FALSE || strpos($route_name, '_form') !== FALSE || strpos($route_name, 'view.') !== FALSE || $route_name == 'entity.node.canonical' || $route_name == 'node.add' || in_array($route_name, $user_routes)) {
      $is_form = TRUE;
    }
  }

  $variables['is_entity_form'] = $is_form;

  // Inyectar datos de logotipo secundario en page.
  $logo_data = _bootstrap_barrio_subtheme_get_secondary_logo_data();
  foreach ($logo_data as $key => $value) {
    $variables[$key] = $value;
  }
}
