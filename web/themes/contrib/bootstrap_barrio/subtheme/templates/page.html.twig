{#
/**
 * @file
 * Bootstrap Barrio's theme implementation to display a single page adapted for ACI Medellín.
 */
#}
{% set sidebar_first_exists = page.sidebar_first|render|striptags('<img><video><audio><drupal-render-placeholder>')|trim is not empty %}
{% set sidebar_second_exists = page.sidebar_second|render|striptags('<img><video><audio><drupal-render-placeholder>')|trim is not empty %}

<script src="https://elfsightcdn.com/platform.js" async></script>
<div class="elfsight-app-5a19dab6-6bdf-4af0-8bed-57ec55a23c0e" data-elfsight-app-lazy></div>

<div id="page-wrapper">
  <div id="page">

    {# Top Bar #}
    {% if page.secondary_menu or page.top_header %}
    <div class="top-bar d-none d-lg-block">
        <div class="container d-flex justify-content-between">
            <div class="top-links">
                {{ page.secondary_menu }}
            </div>
            <div class="top-right">
                {{ page.top_header }}
                <a href="#"><img src="https://acimedellin.org/wp-content/uploads/2021/05/gov-co.png" alt="GOV.CO" height="15"></a>
            </div>
        </div>
    </div>
    {% endif %}

    {# Main Navigation #}
    <header id="header" class="header" role="banner">
      <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
          <div class="navbar-brand">
            {{ page.header }}
          </div>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="mainNavbar">
            <div class="ms-auto">
                {{ page.primary_menu }}
            </div>
          </div>
        </div>
      </nav>
    </header>

    {# Featured Top (Hero / Carousel) #}
    {% if page.featured_top %}
      <section class="region-featured-top">
          {{ page.featured_top }}
      </section>
    {% endif %}

    {# Highlighted / Breadcrumb #}
    {% if page.highlighted or page.breadcrumb %}
      <div class="container mt-4">
        {{ page.highlighted }}
        {{ page.breadcrumb }}
      </div>
    {% endif %}

    {# Main Content Area #}
    <div id="main-wrapper" class="layout-main-wrapper clearfix">
      <div id="main"{{ sidebar_first_exists or sidebar_second_exists or is_entity_form ? ' class="container my-5"' : '' }}>
        <div class="row row-offcanvas row-offcanvas-left clearfix">
          <main{{ content_attributes }} class="col">
            <section class="section">
              <a href="#main-content" id="main-content" tabindex="-1"></a>
              {{ page.content }}
            </section>
          </main>

          {% if sidebar_first_exists %}
            <div{{ sidebar_first_attributes }} class="col-lg-3">
              <aside class="section" role="complementary">
                {{ page.sidebar_first }}
              </aside>
            </div>
          {% endif %}

          {% if sidebar_second_exists %}
            <div{{ sidebar_second_attributes }} class="col-lg-3">
              <aside class="section" role="complementary">
                {{ page.sidebar_second }}
              </aside>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    {# Featured Bottom #}
    {% if page.featured_bottom_first or page.featured_bottom_second or page.featured_bottom_third %}
      <section class="featured-bottom py-5 stories-section">
        <div class="container">
          <div class="row g-4">
            <div class="col-md-4">{{ page.featured_bottom_first }}</div>
            <div class="col-md-4">{{ page.featured_bottom_second }}</div>
            <div class="col-md-4">{{ page.featured_bottom_third }}</div>
          </div>
        </div>
      </section>
    {% endif %}

    {# Footer #}
    <footer class="site-footer">
      <div class="container">
        <div class="row g-5">
          <div class="col-lg-4">
            {{ page.footer_first }}
            <div class="social-links mt-4">
              <a href="#" class="me-3 text-white"><i class="fab fa-facebook-f"></i></a>
              <a href="#" class="me-3 text-white"><i class="fab fa-twitter"></i></a>
              <a href="#" class="me-3 text-white"><i class="fab fa-instagram"></i></a>
            </div>
          </div>
          <div class="col-lg-2">
            {{ page.footer_second }}
          </div>
          <div class="col-lg-3">
            {{ page.footer_third }}
          </div>
          <div class="col-lg-3 text-lg-end">
            {{ page.footer_fourth }}
            {{ page.footer_fifth }}
          </div>
        </div>
        <hr class="my-5 opacity-25">
        <div class="text-center small opacity-75">
          <p>© {{ "now"|date("Y") }} Proyecto Zinco. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>

  </div>
</div>
